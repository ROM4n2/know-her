---
/**
 * EmergencyCountdown.astro — 紧急避孕 72h / 120h 黄金窗口倒计时器
 * 纯客户端离线计算，零隐私上传
 */
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<div class="rounded-3xl border border-[#15140F]/15 bg-white p-6 sm:p-7 shadow-[3px_3px_0_rgba(21,20,15,0.08)] space-y-6">
  <div class="flex items-center justify-between border-b border-[#15140F]/10 pb-4">
    <div class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#15140F] text-white shadow-2xs">
        <svg class="w-4 h-4 text-rose-200" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
      </span>
      <div>
        <h3 class="text-base sm:text-lg font-bold text-[#15140F]">
          紧急避孕 72h / 120h 黄金窗口倒计时
        </h3>
        <p class="text-xs text-[#5A5448]">输入意外同房时间，实时计算时效窗口与最优补救方案</p>
      </div>
    </div>
    <span class="hidden sm:inline-flex rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-[11px] font-medium text-emerald-800">
      纯本地离线计算
    </span>
  </div>

  {/* 时间输入区 */}
  <div class="space-y-3">
    <label class="block text-xs font-bold text-[#15140F]">
      请选择意外或无保护行为发生的大致时间：
    </label>
    <div class="flex flex-col sm:flex-row gap-3">
      <input
        type="datetime-local"
        id="ec-datetime-input"
        class="rounded-xl border border-[#15140F]/20 bg-[#FAF8F5] px-3.5 py-2.5 text-xs sm:text-sm font-mono text-[#15140F] focus:border-rose-500 focus:outline-hidden focus:ring-2 focus:ring-rose-100 shadow-2xs flex-1"
      />
      <div class="flex flex-wrap gap-1.5" id="ec-quick-buttons">
        <button
          type="button"
          data-hours-ago="1"
          class="rounded-lg border border-[#15140F]/15 bg-white px-2.5 py-1.5 text-xs text-[#5A5448] hover:border-rose-400 hover:text-rose-600 active:translate-x-0.5 active:translate-y-0.5 transition-all cursor-pointer shadow-2xs"
        >
          1小时前
        </button>
        <button
          type="button"
          data-hours-ago="6"
          class="rounded-lg border border-[#15140F]/15 bg-white px-2.5 py-1.5 text-xs text-[#5A5448] hover:border-rose-400 hover:text-rose-600 active:translate-x-0.5 active:translate-y-0.5 transition-all cursor-pointer shadow-2xs"
        >
          6小时前
        </button>
        <button
          type="button"
          data-hours-ago="12"
          class="rounded-lg border border-[#15140F]/15 bg-white px-2.5 py-1.5 text-xs text-[#5A5448] hover:border-rose-400 hover:text-rose-600 active:translate-x-0.5 active:translate-y-0.5 transition-all cursor-pointer shadow-2xs"
        >
          昨晚(12h前)
        </button>
        <button
          type="button"
          data-hours-ago="24"
          class="rounded-lg border border-[#15140F]/15 bg-white px-2.5 py-1.5 text-xs text-[#5A5448] hover:border-rose-400 hover:text-rose-600 active:translate-x-0.5 active:translate-y-0.5 transition-all cursor-pointer shadow-2xs"
        >
          24小时前
        </button>
      </div>
    </div>
  </div>

  {/* 实时倒计时卡片 */}
  <div id="ec-result-panel" class="space-y-4">
    {/* 进度条与小时指示 */}
    <div class="rounded-2xl border border-[#15140F]/12 bg-[#FAF8F5] p-4 sm:p-5 space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="font-bold text-[#15140F]">距事件发生已过去：</span>
        <span id="ec-elapsed-text" class="font-mono text-base font-extrabold text-rose-600">
          0 小时 0 分
        </span>
      </div>

      {/* 120小时进度条 */}
      <div class="relative w-full h-3 bg-stone-200 rounded-full overflow-hidden">
        <div
          id="ec-progress-bar"
          class="h-full bg-rose-600 transition-all duration-300 rounded-full"
          style="width: 0%"
        ></div>
      </div>
      <div class="flex justify-between text-[10px] font-mono text-[#8B8676]">
        <span>0h (事发)</span>
        <span class="text-rose-700 font-bold">72h (口服药黄金期)</span>
        <span>120h (IUD终极窗口)</span>
      </div>
    </div>

    {/* 双窗口剩余时间对比 */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
      {/* 72h 窗口卡 */}
      <div class="rounded-xl border border-[#15140F]/12 bg-white p-4 shadow-2xs space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-[#15140F]">72小时口服黄金窗口</span>
          <span id="ec-72-badge" class="rounded-full px-2 py-0.5 text-[10px] font-bold font-mono">
            计算中
          </span>
        </div>
        <div class="space-y-1 text-xs text-[#5A5448]">
          <div>
            首选用药：<strong>左炔诺孕酮 OTC</strong>（1.5mg 单片装如金毓婷，或 0.75mg 双片装间隔 12 小时）
          </div>
          <div class="text-[11px] text-[#8B8676]">
            国内连锁药房、便利店与外卖平台 24 小时均可购得，无需处方。
          </div>
        </div>
        <div class="text-xs font-mono font-bold" id="ec-72-remaining">
          剩余：-- 小时
        </div>
      </div>

      {/* 120h 窗口卡 */}
      <div class="rounded-xl border border-[#15140F]/12 bg-white p-4 shadow-2xs space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-[#15140F]">120小时医疗终极窗口</span>
          <span id="ec-120-badge" class="rounded-full px-2 py-0.5 text-[10px] font-bold font-mono">
            计算中
          </span>
        </div>
        <div class="space-y-1 text-xs text-[#5A5448]">
          <div>
            终极方案：<strong>急诊放置含铜 IUD</strong>，或遵医嘱处方 <strong>低剂量米非司酮 (10mg / 25mg)</strong>
          </div>
          <div class="text-[11px] text-[#8B8676]">
            醋酸乌利司他国内零售药房暂未普及，切勿盲目检索代购而延误黄金时效。
          </div>
        </div>
        <div class="text-xs font-mono font-bold" id="ec-120-remaining">
          剩余：-- 小时
        </div>
      </div>
    </div>

    {/* 动态医学建议结论卡 */}
    <div id="ec-advice-card" class="rounded-2xl border p-4 sm:p-5 space-y-2.5">
      <div class="flex items-center gap-2">
        <h4 id="ec-advice-title" class="font-bold text-sm sm:text-base text-[#15140F]">
          方案结论
        </h4>
      </div>
      <p id="ec-advice-desc" class="text-xs sm:text-sm text-[#2A2620] leading-relaxed">
        请选择时间以生成针对性处置建议。
      </p>
      <div class="pt-2 border-t border-[#15140F]/10 flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="text-[#8B8676]">依据：WHO 紧急避孕实况报道 & 默沙东大众版</span>
        <a
          href={`${base}articles/contraception-emergency-pill/`}
          class="font-semibold text-rose-600 hover:text-rose-700 hover:underline inline-flex items-center gap-1"
        >
          <span>查阅紧急避孕药避坑导读</span>
          <span>→</span>
        </a>
      </div>
    </div>

    {/* 服药后 2 小时胃部吸收观察计时器 */}
    <div
      id="ec-vomit-timer-container"
      class="rounded-2xl border border-[#15140F]/12 bg-[#FAF8F5] p-4 sm:p-5 space-y-3"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#15140F]/10 pb-2">
        <div class="flex items-center gap-2">
          <span class="rounded-sm bg-[#15140F] px-1.5 py-0.5 text-[10px] font-mono font-bold text-white uppercase tracking-wider">
            OBSERVE 2H
          </span>
          <h4 class="text-xs sm:text-sm font-bold text-[#15140F]">
            [ 服药后 2 小时胃部吸收观察计时器 ]
          </h4>
        </div>
        <span class="text-[10px] text-[#8B8676]">纯本地计时 · 零数据上传</span>
      </div>

      <p class="text-[11px] sm:text-xs text-[#5A5448] leading-relaxed">
        <strong class="text-[#15140F]">循证要点：</strong>
        服药后 2 小时内若发生呕吐，药物可能尚未被充分吸收，必须立即补服同等剂量 1 片；超过 2 小时后药物已基本吸收完全，即使呕吐也无需重复补服。
      </p>

      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <div class="flex items-baseline gap-2">
          <span
            id="ec-vomit-timer-display"
            class="font-mono text-2xl sm:text-3xl font-extrabold text-rose-600 tabular-nums"
          >
            120:00
          </span>
          <span id="ec-vomit-timer-status" class="text-[11px] font-medium text-[#8B8676]">
            尚未开启观察
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:ml-auto">
          <button
            type="button"
            id="ec-vomit-timer-btn"
            class="rounded-xl border border-[#15140F] bg-[#15140F] px-3.5 py-2 text-xs font-bold text-white shadow-[2px_2px_0_rgba(21,20,15,0.25)] hover:bg-rose-600 active:translate-x-0.5 active:translate-y-0.5 transition-all cursor-pointer"
          >
            [ 我已服药，开启 2 小时吸收观察计时 ]
          </button>
          <button
            type="button"
            id="ec-vomit-timer-reset-btn"
            class="rounded-xl border border-[#15140F]/20 bg-white px-3 py-2 text-xs font-medium text-[#5A5448] hover:border-[#15140F] hover:text-[#15140F] active:translate-x-0.5 active:translate-y-0.5 transition-all cursor-pointer"
          >
            [ 重置计时 ]
          </button>
        </div>
      </div>

      <div
        id="ec-vomit-timer-note"
        class="hidden rounded-xl border border-emerald-200 bg-emerald-50/70 p-3 text-[11px] sm:text-xs text-emerald-900 leading-relaxed"
      >
        2 小时观察期已满：药物已被充分吸收，此刻起即使呕吐也无需补服。请按计划在无保护行为后第 14 天使用晨尿验孕棒确认避孕效果。
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const input = document.getElementById('ec-datetime-input');
    const elapsedText = document.getElementById('ec-elapsed-text');
    const progressBar = document.getElementById('ec-progress-bar');
    const badge72 = document.getElementById('ec-72-badge');
    const rem72 = document.getElementById('ec-72-remaining');
    const badge120 = document.getElementById('ec-120-badge');
    const rem120 = document.getElementById('ec-120-remaining');
    const adviceCard = document.getElementById('ec-advice-card');
    const adviceTitle = document.getElementById('ec-advice-title');
    const adviceDesc = document.getElementById('ec-advice-desc');

    if (!input) return;

    // 默认设置为 2 小时前
    function setDefaultTime(hoursAgo = 2) {
      const now = new Date();
      now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
      now.setHours(now.getHours() - hoursAgo);
      input.value = now.toISOString().slice(0, 16);
      calculate();
    }

    function calculate() {
      if (!input.value) return;
      const eventTime = new Date(input.value);
      const now = new Date();
      const diffMs = now.getTime() - eventTime.getTime();

      if (diffMs < 0) {
        elapsedText.textContent = '时间在未来？请检查输入';
        progressBar.style.width = '0%';
        return;
      }

      const diffHours = diffMs / (1000 * 60 * 60);
      const wholeHours = Math.floor(diffHours);
      const wholeMins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

      elapsedText.textContent = `${wholeHours} 小时 ${wholeMins} 分钟`;

      // 进度百分比 (基于 120h)
      const pct = Math.min(100, Math.max(0, (diffHours / 120) * 100));
      progressBar.style.width = `${pct}%`;

      // 72h 判定
      const left72 = 72 - diffHours;
      if (left72 > 0) {
        badge72.className = 'rounded-full px-2 py-0.5 text-[10px] font-bold font-mono bg-emerald-100 text-emerald-800';
        badge72.textContent = '有效窗口内';
        rem72.className = 'text-xs font-mono font-bold text-emerald-700';
        rem72.textContent = `剩余约 ${Math.floor(left72)} 小时 ${Math.floor((left72 % 1) * 60)} 分`;
      } else {
        badge72.className = 'rounded-full px-2 py-0.5 text-[10px] font-bold font-mono bg-stone-200 text-stone-600';
        badge72.textContent = '已失效';
        rem72.className = 'text-xs font-mono font-bold text-stone-500';
        rem72.textContent = `已超出 ${Math.floor(Math.abs(left72))} 小时`;
      }

      // 120h 判定
      const left120 = 120 - diffHours;
      if (left120 > 0) {
        badge120.className = 'rounded-full px-2 py-0.5 text-[10px] font-bold font-mono bg-emerald-100 text-emerald-800';
        badge120.textContent = '有效窗口内';
        rem120.className = 'text-xs font-mono font-bold text-emerald-700';
        rem120.textContent = `剩余约 ${Math.floor(left120)} 小时 ${Math.floor((left120 % 1) * 60)} 分`;
      } else {
        badge120.className = 'rounded-full px-2 py-0.5 text-[10px] font-bold font-mono bg-stone-200 text-stone-600';
        badge120.textContent = '已失效';
        rem120.className = 'text-xs font-mono font-bold text-stone-500';
        rem120.textContent = `已超出 ${Math.floor(Math.abs(left120))} 小时`;
      }

      // 综合处置方案
      if (diffHours <= 24) {
        adviceCard.className = 'rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 sm:p-5 space-y-2.5';
        adviceTitle.className = 'font-bold text-sm sm:text-base text-emerald-950';
        adviceTitle.textContent = '[ 24小时黄金期 · 95%有效率 ] 建议尽快口服左炔诺孕酮';
        adviceDesc.textContent = '请尽早前往就近正规药店或外卖购买左炔诺孕酮（1.5mg 单片装或 0.75mg 双片装间隔12小时），服用越早效果越好。服药后 2 小时内若发生呕吐，必须原剂量补服一片。';
      } else if (diffHours <= 72) {
        adviceCard.className = 'rounded-2xl border border-amber-200 bg-amber-50/70 p-4 sm:p-5 space-y-2.5';
        adviceTitle.className = 'font-bold text-sm sm:text-base text-amber-950';
        adviceTitle.textContent = '[ 24~72小时次级期 · 效果递减 ] 仍可口服但应立即执行';
        adviceDesc.textContent = '常规左炔诺孕酮口服药依然有效但成功率随时间递减，请不要再拖延，立即购买服用！若有条件且体重偏大（BMI>25），可考虑公立医院急诊放置含铜节育器（IUD）作为终极保险。';
      } else if (diffHours <= 120) {
        adviceCard.className = 'rounded-2xl border border-rose-200 bg-rose-50/70 p-4 sm:p-5 space-y-2.5';
        adviceTitle.className = 'font-bold text-sm sm:text-base text-rose-950';
        adviceTitle.textContent = '[ 超出72小时口服窗口 · 需急诊介入 ] 常规药失效，需医院处置';
        adviceDesc.textContent = '常规左炔诺孕酮（毓婷）已基本无效，请勿盲目大剂量滥服！请在 120 小时（5天）内前往公立医院妇科急诊，由医生评估急诊放置含铜宫内节育器（IUD，避孕有效率仍高达 99% 以上），或由医生评估开具处方低剂量米非司酮 (10mg / 25mg)。注意：醋酸乌利司他国内零售药房暂未普及，切勿盲目检索代购而延误黄金时效。';
      } else {
        adviceCard.className = 'rounded-2xl border border-stone-200 bg-stone-100 p-4 sm:p-5 space-y-2.5';
        adviceTitle.className = 'font-bold text-sm sm:text-base text-stone-900';
        adviceTitle.textContent = '[ 超出120小时全部窗口 ] 紧急避孕已失效，转入随访';
        adviceDesc.textContent = '受精卵很可能已完成着床，任何紧急避孕药物与操作均已失效。切忌相信网络偏方或私自加大药量伤害身体。请保持平和心态，在同房满 14 天后购买早孕试纸使用晨尿初筛，或在下次月经延期 7 天后前往公立医院抽血查 HCG。';
      }
    }

    input.addEventListener('change', calculate);
    input.addEventListener('input', calculate);

    document.querySelectorAll('#ec-quick-buttons button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const hoursAgo = parseFloat(btn.getAttribute('data-hours-ago') || '2');
        setDefaultTime(hoursAgo);
      });
    });

    // ===== 服药后 2 小时胃部吸收观察计时器 =====
    const vomitTimerDisplay = document.getElementById('ec-vomit-timer-display');
    const vomitTimerStatus = document.getElementById('ec-vomit-timer-status');
    const vomitTimerBtn = document.getElementById('ec-vomit-timer-btn');
    const vomitTimerResetBtn = document.getElementById('ec-vomit-timer-reset-btn');
    const vomitTimerNote = document.getElementById('ec-vomit-timer-note');

    const VOMIT_OBSERVE_SECONDS = 120 * 60;
    let vomitTimerId = null;
    let vomitRemaining = VOMIT_OBSERVE_SECONDS;

    function formatVomitClock(totalSeconds) {
      const safe = Math.max(0, totalSeconds);
      const mins = Math.floor(safe / 60);
      const secs = safe % 60;
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function renderVomitTimer() {
      if (vomitTimerDisplay) vomitTimerDisplay.textContent = formatVomitClock(vomitRemaining);
    }

    // 单一计时器实例管理：创建前必先清理，杜绝多个 interval 叠加造成的内存泄漏
    function stopVomitTimer() {
      if (vomitTimerId !== null) {
        clearInterval(vomitTimerId);
        vomitTimerId = null;
      }
    }

    function completeVomitTimer() {
      stopVomitTimer();
      vomitRemaining = 0;
      renderVomitTimer();
      if (vomitTimerStatus) vomitTimerStatus.textContent = '观察期已结束（药物已充分吸收）';
      if (vomitTimerNote) vomitTimerNote.classList.remove('hidden');
      if (vomitTimerDisplay) {
        vomitTimerDisplay.classList.remove('text-rose-600');
        vomitTimerDisplay.classList.add('text-emerald-700');
      }
    }

    function startVomitTimer() {
      stopVomitTimer();
      vomitRemaining = VOMIT_OBSERVE_SECONDS;
      renderVomitTimer();
      if (vomitTimerNote) vomitTimerNote.classList.add('hidden');
      if (vomitTimerDisplay) {
        vomitTimerDisplay.classList.remove('text-emerald-700');
        vomitTimerDisplay.classList.add('text-rose-600');
      }
      if (vomitTimerStatus) vomitTimerStatus.textContent = '观察中：2 小时内呕吐需原剂量补服';
      vomitTimerId = setInterval(() => {
        vomitRemaining -= 1;
        if (vomitRemaining <= 0) {
          completeVomitTimer();
          return;
        }
        renderVomitTimer();
      }, 1000);
    }

    function resetVomitTimer() {
      stopVomitTimer();
      vomitRemaining = VOMIT_OBSERVE_SECONDS;
      renderVomitTimer();
      if (vomitTimerNote) vomitTimerNote.classList.add('hidden');
      if (vomitTimerDisplay) {
        vomitTimerDisplay.classList.remove('text-emerald-700');
        vomitTimerDisplay.classList.add('text-rose-600');
      }
      if (vomitTimerStatus) vomitTimerStatus.textContent = '尚未开启观察';
    }

    vomitTimerBtn?.addEventListener('click', startVomitTimer);
    vomitTimerResetBtn?.addEventListener('click', resetVomitTimer);

    // 页面卸载时释放计时器资源
    window.addEventListener('pagehide', stopVomitTimer);

    // 初始化
    setDefaultTime(2);
  })();
</script>
