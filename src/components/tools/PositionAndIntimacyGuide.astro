      color: #15140F !important;
    }
    .position-intimacy-no-print {
      display: none !important;
    }
    #panel-positions {
      display: none !important;
    }
    #panel-checklist {
      display: block !important;
    }
    .checklist-item-card {
      display: none !important;
    }
    #intimacy-memo-container {
      box-shadow: none !important;
      border: 1px solid #15140F !important;
      background: white !important;
      margin: 0 !important;
      padding: 1.5rem !important;
      page-break-inside: avoid;
    }
  }
</style>

{/* 嵌入只读静态数据供客户端原生脚本使用 */}
<script type="application/json" id="position-methods-data" set:html={positionsJson}></script>
<script type="application/json" id="intimacy-checklist-data" set:html={checklistConfigsJson}></script>
<script type="application/json" id="position-article-map" set:html={articleMapJson}></script>

{/* 纯前端原生交互脚本 (Zero innerHTML, 纯客户端离线闭包) */}
<script is:inline>
  (function initPositionAndIntimacyGuide() {
    var root = document.getElementById('position-intimacy-root');
    if (!root) return;

    var baseUrl = (root.getAttribute('data-base-url') || '/').replace(/\/+$/, '') + '/';

    // 1. 数据反序列化
    var positions = [];
    var checklistConfigs = [];
    var articleMap = {};
    try {
      var methodsElem = document.getElementById('position-methods-data');
      var checklistElem = document.getElementById('intimacy-checklist-data');
      var articleMapElem = document.getElementById('position-article-map');
      if (methodsElem) positions = JSON.parse(methodsElem.textContent || '[]');
      if (checklistElem) checklistConfigs = JSON.parse(checklistElem.textContent || '[]');
      if (articleMapElem) articleMap = JSON.parse(articleMapElem.textContent || '{}');
    } catch (e) {
      console.error('Failed to parse guide data', e);
      return;
    }

    // Tabs
    var tabBtnPositions = document.getElementById('tab-btn-positions');
    var tabBtnChecklist = document.getElementById('tab-btn-checklist');
    var panelPositions = document.getElementById('panel-positions');
    var panelChecklist = document.getElementById('panel-checklist');

    // Filter Elements
    var filterButtons = root.querySelectorAll('.position-filter-btn');
    var cards = root.querySelectorAll('.position-card');
    var resetFilterBtn = document.getElementById('position-reset-filter-btn');
    var filterCountEl = document.getElementById('position-filter-count');

    // Compare Elements
    var compareToggleBtns = root.querySelectorAll('.position-compare-toggle-btn');
    var floatingBar = document.getElementById('position-floating-bar');
    var floatingStatus = document.getElementById('position-floating-status');
    var floatingChips = document.getElementById('position-floating-chips');
    var floatingClearBtn = document.getElementById('position-floating-clear-btn');
    var openCompareBtn = document.getElementById('position-open-compare-btn');

    var compareDrawer = document.getElementById('position-compare-drawer');
    var closeModalBtn = document.getElementById('position-close-modal-btn');
    var modalCloseBottomBtn = document.getElementById('position-modal-close-bottom-btn');
    var tableContainer = document.getElementById('position-table-container');

    // Checklist Elements
    var choiceBtns = root.querySelectorAll('.checklist-choice-btn');
    var memoYesList = document.getElementById('memo-yes-list');
    var memoMaybeList = document.getElementById('memo-maybe-list');
    var memoNoList = document.getElementById('memo-no-list');
    var copyBtn = document.getElementById('intimacy-copy-btn');
    var copyBtnText = document.getElementById('intimacy-copy-btn-text');
    var printBtn = document.getElementById('intimacy-print-btn');
    var resetChecklistBtn = document.getElementById('intimacy-reset-btn');
    var memoDateEl = document.getElementById('intimacy-memo-date');

    if (memoDateEl) {
      var now = new Date();
      var yr = now.getFullYear();
      var mo = String(now.getMonth() + 1).padStart(2, '0');
      var da = String(now.getDate()).padStart(2, '0');
      memoDateEl.textContent = yr + '-' + mo + '-' + da + ' · 纯前端离线生成';
    }

    // =========================================================================
    // 3. Dual-Tab 切换逻辑
    // =========================================================================
    function switchTab(activeTab) {
      if (activeTab === 'positions') {
        tabBtnPositions.classList.add('bg-[#15140F]', 'text-white', 'border-[#15140F]', 'font-bold', 'shadow-[2px_2px_0_rgba(21,20,15,1)]');
        tabBtnPositions.classList.remove('bg-[#FAF8F5]', 'text-[#5A5448]', 'border-[#15140F]/15', 'font-semibold');
        tabBtnPositions.setAttribute('aria-selected', 'true');

        tabBtnChecklist.classList.remove('bg-[#15140F]', 'text-white', 'border-[#15140F]', 'font-bold', 'shadow-[2px_2px_0_rgba(21,20,15,1)]');
        tabBtnChecklist.classList.add('bg-[#FAF8F5]', 'text-[#5A5448]', 'border-[#15140F]/15', 'font-semibold');
        tabBtnChecklist.setAttribute('aria-selected', 'false');

        panelPositions.classList.remove('hidden');
        panelChecklist.classList.add('hidden');
      } else {
        tabBtnChecklist.classList.add('bg-[#15140F]', 'text-white', 'border-[#15140F]', 'font-bold', 'shadow-[2px_2px_0_rgba(21,20,15,1)]');
        tabBtnChecklist.classList.remove('bg-[#FAF8F5]', 'text-[#5A5448]', 'border-[#15140F]/15', 'font-semibold');
        tabBtnChecklist.setAttribute('aria-selected', 'true');

        tabBtnPositions.classList.remove('bg-[#15140F]', 'text-white', 'border-[#15140F]', 'font-bold', 'shadow-[2px_2px_0_rgba(21,20,15,1)]');
        tabBtnPositions.classList.add('bg-[#FAF8F5]', 'text-[#5A5448]', 'border-[#15140F]/15', 'font-semibold');
        tabBtnPositions.setAttribute('aria-selected', 'false');

        panelChecklist.classList.remove('hidden');
        panelPositions.classList.add('hidden');
      }
    }

    if (tabBtnPositions && tabBtnChecklist) {
      tabBtnPositions.addEventListener('click', function() { switchTab('positions'); });
      tabBtnChecklist.addEventListener('click', function() { switchTab('checklist'); });
    }

    // =========================================================================
    // 4. Tab 1: 体位筛选逻辑
    // =========================================================================
    function applyFilter(filterKey) {
      var visibleCount = 0;

      filterButtons.forEach(function(btn) {
        var key = btn.getAttribute('data-filter');
        var dot = btn.querySelector('.filter-dot');
        if (key === filterKey) {
          btn.classList.remove('bg-white', 'text-[#5A5448]', 'border-[#15140F]/15', 'font-semibold');
          btn.classList.add('bg-[#15140F]', 'text-white', 'border-[#15140F]', 'font-bold', 'shadow-[2px_2px_0_rgba(21,20,15,1)]');
          if (dot) {
            dot.classList.remove('bg-[#15140F]/20');
            dot.classList.add('bg-rose-400');
          }
        } else {
          btn.classList.remove('bg-[#15140F]', 'text-white', 'border-[#15140F]', 'font-bold', 'shadow-[2px_2px_0_rgba(21,20,15,1)]');
          btn.classList.add('bg-white', 'text-[#5A5448]', 'border-[#15140F]/15', 'font-semibold');
          if (dot) {
            dot.classList.remove('bg-rose-400');
            dot.classList.add('bg-[#15140F]/20');
          }
        }
      });

      cards.forEach(function(card) {
        var tags = (card.getAttribute('data-filter-tags') || '').split(' ');
        var matches = filterKey === 'all' || tags.indexOf(filterKey) !== -1;
        if (matches) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (filterCountEl) {
        filterCountEl.textContent = '已筛选出 ' + visibleCount + ' / 8 种循证体位';
      }

      if (resetFilterBtn) {
        if (filterKey === 'all') {
          resetFilterBtn.classList.add('hidden');
        } else {
          resetFilterBtn.classList.remove('hidden');
        }
      }
    }

    filterButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key = btn.getAttribute('data-filter');
        if (key) applyFilter(key);
      });
    });

    if (resetFilterBtn) {
      resetFilterBtn.addEventListener('click', function() {
        applyFilter('all');
      });
    }

    // =========================================================================
    // 5. Tab 1: 两两对比逻辑 (Head-to-Head Compare)
    // =========================================================================
    var selectedPositionIds = [];

    function updateCompareUI() {
      // 1. 卡片按钮状态更新
      compareToggleBtns.forEach(function(btn) {
        var posId = btn.getAttribute('data-position-id');
        var isSelected = selectedPositionIds.indexOf(posId) !== -1;
        var indicator = btn.querySelector('.compare-checkbox-indicator');
        var checkIcon = btn.querySelector('.check-icon');
        var label = btn.querySelector('.compare-btn-label');

        btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        if (isSelected) {
          btn.classList.remove('bg-white', 'text-[#15140F]');
          btn.classList.add('bg-[#15140F]', 'text-white');
          if (indicator) {
            indicator.classList.remove('bg-white');
            indicator.classList.add('bg-rose-600', 'border-rose-600');
          }
          if (checkIcon) checkIcon.classList.remove('hidden');
          if (label) label.textContent = '已加入横向对比 (点击取消)';
        } else {
          btn.classList.remove('bg-[#15140F]', 'text-white');
          btn.classList.add('bg-white', 'text-[#15140F]');
          if (indicator) {
            indicator.classList.remove('bg-rose-600', 'border-rose-600');
            indicator.classList.add('bg-white');
          }
          if (checkIcon) checkIcon.classList.add('hidden');
          if (label) label.textContent = '加入横向对比 (最多选 2 项)';
        }
      });

      // 2. 悬浮栏状态更新
      if (selectedPositionIds.length > 0) {
        floatingBar.classList.remove('hidden');
        floatingStatus.textContent = '已选择 ' + selectedPositionIds.length + ' / 2 项体位';

        // 渲染 Chip 标签 (纯 DOM 构造)
        floatingChips.replaceChildren();
        selectedPositionIds.forEach(function(id) {
          var posObj = positions.find(function(p) { return p.id === id; });
          var chip = document.createElement('span');
          chip.className = 'inline-flex items-center gap-1 rounded-md bg-stone-100 border border-stone-200 px-2 py-0.5 font-mono text-[10px] text-[#2A2620]';
          chip.textContent = posObj ? posObj.name : id;
          floatingChips.appendChild(chip);
        });

        if (selectedPositionIds.length >= 2) {
          openCompareBtn.removeAttribute('disabled');
          openCompareBtn.textContent = '查看双体位横向比对 (2/2)';
        } else {
          openCompareBtn.removeAttribute('disabled');
          openCompareBtn.textContent = '查看单体位力学详情 (1/2)';
        }
      } else {
        floatingBar.classList.add('hidden');
        floatingChips.replaceChildren();
      }
    }

    compareToggleBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var posId = btn.getAttribute('data-position-id');
        if (!posId) return;

        var idx = selectedPositionIds.indexOf(posId);
        if (idx !== -1) {
          selectedPositionIds.splice(idx, 1);
        } else {
          if (selectedPositionIds.length >= 2) {
            // 超出两项：自动顶替第一项或提醒
            selectedPositionIds.shift();
          }
          selectedPositionIds.push(posId);
        }
        updateCompareUI();
      });
    });

    if (floatingClearBtn) {
      floatingClearBtn.addEventListener('click', function() {
        selectedPositionIds = [];
        updateCompareUI();
      });
    }

    // =========================================================================
    // 6. 对比弹窗渲染 (Zero innerHTML 模式)
    // =========================================================================
    function renderCompareTable() {
      if (!tableContainer) return;
      tableContainer.replaceChildren();

      var posA = positions.find(function(p) { return p.id === selectedPositionIds[0]; });
      var posB = positions.find(function(p) { return p.id === selectedPositionIds[1]; });

      if (!posA) {
        var emptyNotice = document.createElement('p');
        emptyNotice.className = 'text-xs text-[#8B8676] py-8 text-center';
        emptyNotice.textContent = '尚未选择任何体位进行对比，请至少选择 1 项。';
        tableContainer.appendChild(emptyNotice);
        return;
      }

      var table = document.createElement('table');
      table.className = 'w-full border-collapse text-left text-xs';

      // thead
      var thead = document.createElement('thead');
      var trHead = document.createElement('tr');
      trHead.className = 'border-b-2 border-[#15140F] bg-white';

      var thMetric = document.createElement('th');
      thMetric.className = 'p-3 font-mono font-bold text-[#15140F] w-1/4 sm:w-1/5';
      thMetric.textContent = '生理力学指标';
      trHead.appendChild(thMetric);

      var thA = document.createElement('th');
      thA.className = 'p-3 font-extrabold text-[#15140F] border-l border-[#15140F]/10 w-3/8 sm:w-2/5';
      thA.textContent = posA.name + ' (' + posA.en_name + ')';
      trHead.appendChild(thA);

      var thB = document.createElement('th');
      thB.className = 'p-3 font-extrabold text-[#15140F] border-l border-[#15140F]/10 w-3/8 sm:w-2/5';
      thB.textContent = posB ? posB.name + ' (' + posB.en_name + ')' : '待选择对比体位 (可选)';
      trHead.appendChild(thB);

      thead.appendChild(trHead);
      table.appendChild(thead);

      // tbody
      var tbody = document.createElement('tbody');

      function addRow(label, valA, valB, isList) {
        var tr = document.createElement('tr');
        tr.className = 'border-b border-[#15140F]/10 hover:bg-[#FAF8F5] transition-colors';

        var tdLabel = document.createElement('td');
        tdLabel.className = 'p-3 font-bold text-[#15140F] bg-stone-50/50 align-top';
        tdLabel.textContent = label;
        tr.appendChild(tdLabel);

        var tdA = document.createElement('td');
        tdA.className = 'p-3 text-[#2A2620] leading-relaxed border-l border-[#15140F]/10 align-top';
        if (isList && Array.isArray(valA)) {
          var ulA = document.createElement('ul');
          ulA.className = 'space-y-1 list-disc pl-4 text-[11px]';
          valA.forEach(function(item) {
            var li = document.createElement('li');
            li.textContent = item;
            ulA.appendChild(li);
          });
          tdA.appendChild(ulA);
        } else {
          tdA.textContent = valA || '--';
        }
        tr.appendChild(tdA);

        var tdB = document.createElement('td');
        tdB.className = 'p-3 text-[#2A2620] leading-relaxed border-l border-[#15140F]/10 align-top';
        if (!posB) {
          tdB.className += ' text-[#8B8676] italic';
          tdB.textContent = '可在体位矩阵中再勾选 1 项体位进行双向比对';
        } else if (isList && Array.isArray(valB)) {
          var ulB = document.createElement('ul');
          ulB.className = 'space-y-1 list-disc pl-4 text-[11px]';
          valB.forEach(function(item) {
            var li = document.createElement('li');
            li.textContent = item;
            ulB.appendChild(li);
          });
          tdB.appendChild(ulB);
        } else {
          tdB.textContent = valB || '--';
        }
        tr.appendChild(tdB);

        tbody.appendChild(tr);
      }

      var categoryNameMap = {
        female_control: '女性主导 / 深度自主',
        intimacy_close: '温热贴合 / 亲密研磨',
        low_energy: '低体能消耗 / 放松省力',
        deep_penetration: '深层缓冲 / 角度改良',
      };

      var metricLevelMap = {
        clitoral_high: 'High (阴蒂充分高频贴合/直接刺激)',
        clitoral_moderate: 'Moderate (中度接触/需伴侣或外置辅助)',
        clitoral_low: 'Low (间接贴合/需外在玩具协同)',
        cervical_low: 'Low (极低碰撞/安全缓冲佳/防深部痛)',
        cervical_moderate: 'Moderate (中等风险/需克制冲程与速度)',
        cervical_high: 'High (深部冲撞预警/子宫后位慎选)',
        energy_low: 'Low (轻度省力/适宜久躺放松)',
        energy_moderate: 'Moderate (中等核心负荷/间歇换位)',
        energy_high: 'High (高肌力消耗/耐受维持时间短)',
      };

      addRow('类别定位', categoryNameMap[posA.category] || posA.category, posB ? categoryNameMap[posB.category] : null);
      addRow('进入轴线力学', posA.coital_angle_desc, posB ? posB.coital_angle_desc : null);
      addRow('阴蒂可达度指数', metricLevelMap['clitoral_' + posA.clitoral_access] || posA.clitoral_access, posB ? metricLevelMap['clitoral_' + posB.clitoral_access] : null);
      addRow('宫颈碰撞痛风险', metricLevelMap['cervical_' + posA.cervical_collision_risk] || posA.cervical_collision_risk, posB ? metricLevelMap['cervical_' + posB.cervical_collision_risk] : null);
      addRow('体能消耗等级', metricLevelMap['energy_' + posA.energy_expenditure] || posA.energy_expenditure, posB ? metricLevelMap['energy_' + posB.energy_expenditure] : null);
      addRow('骨盆与硬枕改良支点', posA.pelvic_support_advice, posB ? posB.pelvic_support_advice : null);
      addRow('核心生理优势 (PROS)', posA.pros, posB ? posB.pros : null, true);
      addRow('潜在局限与不适 (CONS)', posA.cons, posB ? posB.cons : null, true);
      addRow('伴侣非暴力沟通提示', posA.communication_tip, posB ? posB.communication_tip : null);

      // 科普长文链接行
      var trLink = document.createElement('tr');
      trLink.className = 'border-b border-[#15140F]/10 bg-white';
      var tdLinkLabel = document.createElement('td');
      tdLinkLabel.className = 'p-3 font-bold text-[#15140F] bg-stone-50/50 align-top';
      tdLinkLabel.textContent = '深度循证科普';
      trLink.appendChild(tdLinkLabel);

      var tdLinkA = document.createElement('td');
      tdLinkA.className = 'p-3 border-l border-[#15140F]/10 align-top';
      var aA = document.createElement('a');
      aA.href = baseUrl + 'articles/' + posA.related_article + '/';
      aA.className = 'inline-flex items-center gap-1 font-bold text-rose-600 hover:text-rose-800 hover:underline';
      aA.textContent = '阅读《' + (articleMap[posA.related_article] || '体位力学') + '》长文 →';
      tdLinkA.appendChild(aA);
      trLink.appendChild(tdLinkA);

      var tdLinkB = document.createElement('td');
      tdLinkB.className = 'p-3 border-l border-[#15140F]/10 align-top';
      if (posB) {
        var aB = document.createElement('a');
        aB.href = baseUrl + 'articles/' + posB.related_article + '/';
        aB.className = 'inline-flex items-center gap-1 font-bold text-rose-600 hover:text-rose-800 hover:underline';
        aB.textContent = '阅读《' + (articleMap[posB.related_article] || '体位力学') + '》长文 →';
        tdLinkB.appendChild(aB);
      } else {
        tdLinkB.textContent = '--';
      }
      trLink.appendChild(tdLinkB);
      tbody.appendChild(trLink);

      table.appendChild(tbody);
      tableContainer.appendChild(table);
    }

    function openModal() {
      renderCompareTable();
      compareDrawer.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      compareDrawer.classList.add('hidden');
      document.body.style.overflow = '';
    }

    if (openCompareBtn) openCompareBtn.addEventListener('click', openModal);
    if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
    if (modalCloseBottomBtn) modalCloseBottomBtn.addEventListener('click', closeModal);

    if (compareDrawer) {
      compareDrawer.addEventListener('click', function(e) {
        if (e.target === compareDrawer) closeModal();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && compareDrawer && !compareDrawer.classList.contains('hidden')) {
        closeModal();
      }
    });

    // =========================================================================
    // 7. Tab 2: 伴侣探索知情清单状态与实时便签渲染 (Zero innerHTML)
    // =========================================================================
    var checklistChoices = new Map(); // itemId -> 'yes' | 'maybe' | 'no'

    // 所有题目的映射表
    var itemsMap = new Map();
    checklistConfigs.forEach(function(cat) {
      cat.items.forEach(function(item) {
        itemsMap.set(item.id, {
          id: item.id,
          title: item.title,
          physiological_reason: item.physiological_reason,
          suggestion_text: item.suggestion_text,
          categoryName: cat.name
        });
      });
    });

    function updateChoiceButtonsUI() {
      choiceBtns.forEach(function(btn) {
        var itemId = btn.getAttribute('data-item-id');
        var choice = btn.getAttribute('data-choice');
        var current = checklistChoices.get(itemId);

        // 重置所有颜色
        if (choice === 'yes') {
          if (current === 'yes') {
            btn.className = 'checklist-choice-btn rounded-lg border border-emerald-600 bg-emerald-600 text-white px-2.5 py-1 text-xs font-bold shadow-2xs active:translate-x-0.5 active:translate-y-0.5 cursor-pointer transition-all';
          } else {
            btn.className = 'checklist-choice-btn rounded-lg border border-emerald-300 bg-white text-emerald-800 px-2.5 py-1 text-xs font-semibold hover:bg-emerald-50 active:translate-x-0.5 active:translate-y-0.5 cursor-pointer transition-all';
          }
        } else if (choice === 'maybe') {
          if (current === 'maybe') {
            btn.className = 'checklist-choice-btn rounded-lg border border-amber-600 bg-amber-600 text-white px-2.5 py-1 text-xs font-bold shadow-2xs active:translate-x-0.5 active:translate-y-0.5 cursor-pointer transition-all';
          } else {
            btn.className = 'checklist-choice-btn rounded-lg border border-amber-300 bg-white text-amber-800 px-2.5 py-1 text-xs font-semibold hover:bg-amber-50 active:translate-x-0.5 active:translate-y-0.5 cursor-pointer transition-all';
          }
        } else if (choice === 'no') {
          if (current === 'no') {
            btn.className = 'checklist-choice-btn rounded-lg border border-rose-600 bg-rose-600 text-white px-2.5 py-1 text-xs font-bold shadow-2xs active:translate-x-0.5 active:translate-y-0.5 cursor-pointer transition-all';
          } else {
            btn.className = 'checklist-choice-btn rounded-lg border border-rose-300 bg-white text-rose-800 px-2.5 py-1 text-xs font-semibold hover:bg-rose-50 active:translate-x-0.5 active:translate-y-0.5 cursor-pointer transition-all';
          }
        }
      });
    }

    function renderExplorationMemo() {
      if (!memoYesList || !memoMaybeList || !memoNoList) return;

      var yesItems = [];
      var maybeItems = [];
      var noItems = [];

      checklistChoices.forEach(function(val, id) {
        var itemData = itemsMap.get(id);
        if (!itemData) return;
        if (val === 'yes') yesItems.push(itemData);
        else if (val === 'maybe') maybeItems.push(itemData);
        else if (val === 'no') noItems.push(itemData);
      });

      // 渲染 YES 列表
      memoYesList.replaceChildren();
      if (yesItems.length === 0) {
        var pYes = document.createElement('p');
        pYes.className = 'text-[#8B8676] italic text-[11px]';
        pYes.textContent = '（暂未勾选优先探索项）';
        memoYesList.appendChild(pYes);
      } else {
        yesItems.forEach(function(item) {
          var itemDiv = document.createElement('div');
          itemDiv.className = 'rounded-lg bg-emerald-50/50 border border-emerald-200/60 p-2 space-y-1';
          var titleSpan = document.createElement('span');
          titleSpan.className = 'font-bold text-xs text-emerald-900 block';
          titleSpan.textContent = '• ' + item.title + ' (' + item.categoryName + ')';
          itemDiv.appendChild(titleSpan);

          var sugP = document.createElement('p');
          sugP.className = 'text-[11px] text-[#2A2620] leading-relaxed pl-3 italic';
          sugP.textContent = item.suggestion_text;
          itemDiv.appendChild(sugP);

          memoYesList.appendChild(itemDiv);
        });
      }

      // 渲染 MAYBE 列表
      memoMaybeList.replaceChildren();
      if (maybeItems.length === 0) {
        var pMaybe = document.createElement('p');
        pMaybe.className = 'text-[#8B8676] italic text-[11px]';
        pMaybe.textContent = '（暂未勾选待定探索项）';
        memoMaybeList.appendChild(pMaybe);
      } else {
        maybeItems.forEach(function(item) {
          var itemDiv = document.createElement('div');
          itemDiv.className = 'rounded-lg bg-amber-50/50 border border-amber-200/60 p-2 space-y-1';
          var titleSpan = document.createElement('span');
          titleSpan.className = 'font-bold text-xs text-amber-900 block';
          titleSpan.textContent = '• ' + item.title + ' (' + item.categoryName + ')';
          itemDiv.appendChild(titleSpan);

          var sugP = document.createElement('p');
          sugP.className = 'text-[11px] text-[#2A2620] leading-relaxed pl-3 italic';
          sugP.textContent = item.suggestion_text;
          itemDiv.appendChild(sugP);

          memoMaybeList.appendChild(itemDiv);
        });
      }

      // 渲染 NO 列表
      memoNoList.replaceChildren();
      if (noItems.length === 0) {
        var pNo = document.createElement('p');
        pNo.className = 'text-[#8B8676] italic text-[11px]';
        pNo.textContent = '（当前无特殊红线避雷项，以双方实时舒适为准）';
        memoNoList.appendChild(pNo);
      } else {
        noItems.forEach(function(item) {
          var itemDiv = document.createElement('div');
          itemDiv.className = 'rounded-lg bg-rose-50/50 border border-rose-200/60 p-2 space-y-1';
          var titleSpan = document.createElement('span');
          titleSpan.className = 'font-bold text-xs text-rose-900 block';
          titleSpan.textContent = '• ' + item.title + ' (' + item.categoryName + ')';
          itemDiv.appendChild(titleSpan);

          var reasonP = document.createElement('p');
          reasonP.className = 'text-[11px] text-rose-800 leading-relaxed pl-3';
          reasonP.textContent = '生理边界理由：' + item.physiological_reason;
          itemDiv.appendChild(reasonP);

          var sugP = document.createElement('p');
          sugP.className = 'text-[11px] text-[#2A2620] leading-relaxed pl-3 italic';
          sugP.textContent = item.suggestion_text;
          itemDiv.appendChild(sugP);

          memoNoList.appendChild(itemDiv);
        });
      }
    }

    choiceBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var itemId = btn.getAttribute('data-item-id');
        var choice = btn.getAttribute('data-choice');
        if (!itemId || !choice) return;

        // 若重复点击已选中的，则取消选择
        if (checklistChoices.get(itemId) === choice) {
          checklistChoices.delete(itemId);
        } else {
          checklistChoices.set(itemId, choice);
        }

        updateChoiceButtonsUI();
        renderExplorationMemo();
      });
    });

    // 重置所有题目
    if (resetChecklistBtn) {
      resetChecklistBtn.addEventListener('click', function() {
        checklistChoices.clear();
        updateChoiceButtonsUI();
        renderExplorationMemo();
      });
    }

    // 复制便签纯文本 (Clipboard API)
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        var lines = [];
        lines.push('========================================');
        lines.push('【伴侣私密探索知情沟通便签】(know-her 离线生成)');
        lines.push('========================================');
        lines.push('亲爱的：在我们的亲密时光里，我希望我们彼此都能感到舒适、安全和被尊重。根据我对自身生理感受的体会，整理了这份温和的知情便签：\n');

        lines.push('01 // 积极期待的探索项 (YES)：');
        var yesFound = false;
        checklistChoices.forEach(function(val, id) {
          if (val === 'yes') {
            yesFound = true;
            var it = itemsMap.get(id);
            if (it) lines.push('  • ' + it.title + ': ' + it.suggestion_text);
          }
        });
        if (!yesFound) lines.push('  （暂未勾选优先探索项）');
        lines.push('');

        lines.push('02 // 需视环境与沟通再定的探索项 (MAYBE)：');
        var maybeFound = false;
        checklistChoices.forEach(function(val, id) {
          if (val === 'maybe') {
            maybeFound = true;
            var it = itemsMap.get(id);
            if (it) lines.push('  • ' + it.title + ': ' + it.suggestion_text);
          }
        });
        if (!maybeFound) lines.push('  （暂未勾选待定探索项）');
        lines.push('');

        lines.push('03 // 当前明确的身体边界与红线 (NO)：');
        var noFound = false;
        checklistChoices.forEach(function(val, id) {
          if (val === 'no') {
            noFound = true;
            var it = itemsMap.get(id);
            if (it) lines.push('  • ' + it.title + ': ' + it.suggestion_text);
          }
        });
        if (!noFound) lines.push('  （当前无特殊红线避雷项，以双方实时舒适为准）');
        lines.push('');

        lines.push('说明：身体的舒适与心理安全感永远排在第一位。任何时候如果感到不适或疼痛，我们都可以随时温柔叫停，无需任何解释或负担。');
        lines.push('========================================');

        var fullText = lines.join('\n');
        navigator.clipboard.writeText(fullText).then(function() {
          if (copyBtnText) {
            var oldText = copyBtnText.textContent;
            copyBtnText.textContent = '[ 便签已复制到剪贴板 ]';
            setTimeout(function() {
              copyBtnText.textContent = oldText;
            }, 2000);
          }
        }).catch(function(err) {
          console.error('Clipboard copy failed', err);
        });
      });
    }

    // 打印便签
    if (printBtn) {
      printBtn.addEventListener('click', function() {
        window.print();
      });
    }

    // 初始渲染
    applyFilter('all');
    updateCompareUI();
    renderExplorationMemo();
  })();
</script>

<script>
  import { exportMemoAsImage } from '../../lib/ui/memoImageExporter';

  function collectListItems(listId: string): string[] {
    const container = document.getElementById(listId);
    if (!container) return [];

    const items = Array.from(container.querySelectorAll<HTMLElement>(':scope > div'));
    if (items.length === 0) {
      const placeholder = (container.textContent ?? '').trim();
      return placeholder ? [placeholder] : [];
    }

    return items.map((item) => {
      const title = (item.querySelector('span')?.textContent ?? '').trim();
      const details = Array.from(item.querySelectorAll('p'))
        .map((p) => (p.textContent ?? '').trim())
        .filter(Boolean);
      return [title, ...details].filter(Boolean).join('｜');
    });
  }

  const exportBtn = document.querySelector<HTMLButtonElement>(
    '#position-intimacy-root .memo-export-image-btn'
  );
  exportBtn?.addEventListener('click', async () => {
    const btnText = document.getElementById('position-memo-export-image-text');
    const originalText = btnText?.textContent ?? '[ 保存便签长图 ]';
    if (btnText) btnText.textContent = '[ 正在生成长图… ]';
    exportBtn?.setAttribute('disabled', 'disabled');

    const sections: Array<{ heading: string; lines: string[] }> = [
      { heading: '积极期待的探索项 (YES)', lines: collectListItems('memo-yes-list') },
      { heading: '需视环境与沟通再定的探索项 (MAYBE)', lines: collectListItems('memo-maybe-list') },
      { heading: '当前明确的身体边界与红线 (NO)', lines: collectListItems('memo-no-list') },
    ].filter((section) => section.lines.length > 0);

    const memoDate = (document.getElementById('intimacy-memo-date')?.textContent ?? '').trim();

    try {
      await exportMemoAsImage({
        title: '伴侣私密探索知情沟通便签',
        subtitle: `Yes / No / Maybe 非暴力沟通框架 · ${memoDate || '本地离线生成'}`,
        sections,
        disclaimer:
          '本便签由 know-her 在你的浏览器本地离线生成，仅供伴侣双方私下沟通使用，绝不上传或留存任何个人偏好数据。身体的舒适与心理安全感永远排在第一位。',
        fileName: `know-her-伴侣探索便签-${new Date().toISOString().slice(0, 10)}`,
      });
      if (btnText) btnText.textContent = '[ 长图已生成，请查看下载 ]';
    } catch (err) {
      if (btnText) btnText.textContent = '[ 长图生成失败，请改用打印 ]';
      console.error('[PositionAndIntimacyGuide] 便签长图导出失败', err);
    } finally {
      exportBtn?.removeAttribute('disabled');
      window.setTimeout(() => {
        if (btnText) btnText.textContent = originalText;
      }, 2600);
    }
  });
</script>
