---
/**
 * PositionAndIntimacyGuide.astro — 体位生理力学矩阵与伴侣探索知情清单复合组件
 * 基于女性盆底解剖学、进入轴线力学与临床 Yes/No/Maybe 脱敏知情协议构建
 * 纯客户端离线计算，零个人数据留存与隐私回传，页面刷新即销毁
 */
import {
  POSITION_METHODS,
  type SexualPosition,
} from '../../data/positionMatrix';
import {
  INTIMACY_CHECKLIST_CONFIGS,
} from '../../data/intimacyChecklist';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// 体位类别中文映射
const categoryBadgeMap: Record<SexualPosition['category'], string> = {
  female_control: '女性主导 / 深度自主',
  intimacy_close: '温热贴合 / 亲密研磨',
  low_energy: '低体能消耗 / 放松省力',
  deep_penetration: '深层缓冲 / 角度改良',
};

// 关联科普文章标题映射
const articleTitleMap: Record<string, string> = {
  'pleasure-woman-on-top-mechanics': '女上位掌控度与深部痛防护力学',
  'pleasure-side-lying-spooning': '侧卧匙羹与剪刀式力学指南',
  'pleasure-rear-entry-angles': '后入位进入轴线与子宫后位避坑',
  'pleasure-cat-technique-alignment': 'CAT性高潮对齐技术科学解析',
  'pleasure-arousal-time-physiology': '女性性唤起生理时间窗口科普',
};

// 计算体位筛选标签
function getFilterTags(pos: SexualPosition): string[] {
  const tags: string[] = ['all'];
  if (pos.clitoral_access === 'high') {
    tags.push('clitoral-high');
  }
  if (pos.category === 'female_control') {
    tags.push('female-control');
  }
  if (pos.energy_expenditure === 'low') {
    tags.push('low-energy');
  }
  if (pos.cervical_collision_risk === 'low') {
    tags.push('cervical-low');
  }
  if (
    pos.pelvic_support_advice.includes('枕') ||
    pos.pelvic_support_advice.includes('垫')
  ) {
    tags.push('pillow');
  }
  return tags;
}

// 序列化数据供客户端原生轻量交互
const positionsJson = JSON.stringify(POSITION_METHODS);
const checklistConfigsJson = JSON.stringify(INTIMACY_CHECKLIST_CONFIGS);
const articleMapJson = JSON.stringify(articleTitleMap);
---

<div
  id="position-intimacy-root"
  data-base-url={base}
  class:list={[
    "rounded-3xl border border-[#15140F]/15 bg-white p-6 sm:p-8 shadow-[3px_3px_0_rgba(21,20,15,0.08)] space-y-8",
    className
  ]}
>
  {/* 顶部标题区 */}
  <header class="border-b border-[#15140F]/10 pb-5 space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#15140F] text-white shadow-2xs">
          <svg class="w-5 h-5 text-rose-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
          </svg>
        </span>
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-rose-700 bg-rose-50 border border-rose-200/80 px-2 py-0.5 rounded-sm mb-1">
            [ 循证性生理力学与知情探索 ]
          </div>
          <h2 class="text-lg sm:text-xl font-extrabold text-[#15140F] tracking-tight">
            [ 体位生理力学矩阵与伴侣探索知情清单 ]
          </h2>
          <p class="text-xs text-[#5A5448] max-w-3xl mt-1 leading-relaxed">
            突破网络低俗姿势误导。从女性解剖迎角、阴蒂可达度、深部撞击痛防护与盆底肌耗能出发，提供科学体位矩阵比对与去尴尬的 Yes/No/Maybe 探索沟通清单。
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 text-[11px] font-mono">
        <span class="rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 font-medium text-emerald-800">
          解剖力学循证
        </span>
        <span class="rounded-full bg-stone-100 border border-stone-200 px-2.5 py-0.5 font-medium text-[#5A5448]">
          本地离线无痕
        </span>
      </div>
    </div>
  </header>

  {/* 顶部双 Tab 切换控制器 */}
  <nav class="position-intimacy-no-print border-b border-[#15140F]/10 pb-1" aria-label="工具功能导航">
    <div class="flex flex-wrap items-center gap-2" role="tablist">
      <button
        type="button"
        id="tab-btn-positions"
        role="tab"
        aria-selected="true"
        aria-controls="panel-positions"
        class="tab-nav-btn inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-xs sm:text-sm font-bold border border-[#15140F] bg-[#15140F] text-white shadow-[2px_2px_0_rgba(21,20,15,1)] cursor-pointer transition-all active:translate-x-0.5 active:translate-y-0.5"
      >
        <svg class="w-4 h-4 text-rose-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
        </svg>
        <span>[ 姿势生理力学知情选择矩阵 ]</span>
      </button>

      <button
        type="button"
        id="tab-btn-checklist"
        role="tab"
        aria-selected="false"
        aria-controls="panel-checklist"
        class="tab-nav-btn inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-xs sm:text-sm font-semibold border border-[#15140F]/15 bg-[#FAF8F5] text-[#5A5448] hover:border-[#15140F]/40 hover:text-[#15140F] cursor-pointer transition-all active:translate-x-0.5 active:translate-y-0.5"
      >
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        <span>[ 伴侣私密探索知情清单 (Yes/No/Maybe) ]</span>
      </button>
    </div>
  </nav>

  {/* ========================================================================= */}
  {/* Tab 1 Panel: 姿势生理力学知情选择矩阵 */}
  {/* ========================================================================= */}
  <div id="panel-positions" role="tabpanel" class="space-y-8">
    {/* 多维筛选栏 (position-filter-container) */}
    <section class="space-y-3">
      <div class="flex items-center justify-between border-b border-[#15140F]/10 pb-2">
        <div class="flex items-center gap-2">
          <span class="rounded-sm bg-[#15140F] px-1.5 py-0.5 text-[10px] font-mono font-bold text-white uppercase tracking-wider">
            FILTER 01
          </span>
          <h3 class="text-sm font-bold text-[#15140F]">
            按生理力学特征与舒适偏好筛选
          </h3>
        </div>
        <span id="position-filter-count" class="text-xs font-mono text-[#8B8676]">
          已收录 8 种循证体位力学方案
        </span>
      </div>

      <div class="position-filter-container flex flex-wrap items-center gap-2 pt-1" id="position-filter-buttons">
        <button
          type="button"
          data-filter="all"
          class="position-filter-btn inline-flex items-center gap-1.5 rounded-full border border-[#15140F] bg-[#15140F] text-white px-3.5 py-1.5 text-xs font-bold shadow-[2px_2px_0_rgba(21,20,15,1)] cursor-pointer transition-all active:translate-x-0.5 active:translate-y-0.5"
        >
          <span class="filter-dot w-1.5 h-1.5 rounded-full bg-rose-400"></span>
          <span>[ 全部收录 (8) ]</span>
        </button>

        <button
          type="button"
          data-filter="clitoral-high"
          class="position-filter-btn inline-flex items-center gap-1.5 rounded-full border border-[#15140F]/15 bg-white text-[#5A5448] px-3.5 py-1.5 text-xs font-semibold hover:border-[#15140F]/40 hover:text-[#15140F] cursor-pointer transition-all active:translate-x-0.5 active:translate-y-0.5"
        >
          <span class="filter-dot w-1.5 h-1.5 rounded-full bg-[#15140F]/20"></span>
          <span>[ 阴蒂高频贴合 ]</span>
        </button>

        <button
          type="button"
          data-filter="female-control"
          class="position-filter-btn inline-flex items-center gap-1.5 rounded-full border border-[#15140F]/15 bg-white text-[#5A5448] px-3.5 py-1.5 text-xs font-semibold hover:border-[#15140F]/40 hover:text-[#15140F] cursor-pointer transition-all active:translate-x-0.5 active:translate-y-0.5"
        >
          <span class="filter-dot w-1.5 h-1.5 rounded-full bg-[#15140F]/20"></span>
          <span>[ 女性自主主导深度 ]</span>
        </button>

        <button
          type="button"
          data-filter="low-energy"
          class="position-filter-btn inline-flex items-center gap-1.5 rounded-full border border-[#15140F]/15 bg-white text-[#5A5448] px-3.5 py-1.5 text-xs font-semibold hover:border-[#15140F]/40 hover:text-[#15140F] cursor-pointer transition-all active:translate-x-0.5 active:translate-y-0.5"
        >
          <span class="filter-dot w-1.5 h-1.5 rounded-full bg-[#15140F]/20"></span>
          <span>[ 低体能消耗/放松 ]</span>
        </button>

        <button
          type="button"
          data-filter="cervical-low"
          class="position-filter-btn inline-flex items-center gap-1.5 rounded-full border border-[#15140F]/15 bg-white text-[#5A5448] px-3.5 py-1.5 text-xs font-semibold hover:border-[#15140F]/40 hover:text-[#15140F] cursor-pointer transition-all active:translate-x-0.5 active:translate-y-0.5"
        >
          <span class="filter-dot w-1.5 h-1.5 rounded-full bg-[#15140F]/20"></span>
          <span>[ 避免深部撞击痛 ]</span>
        </button>

        <button
          type="button"
          data-filter="pillow"
          class="position-filter-btn inline-flex items-center gap-1.5 rounded-full border border-[#15140F]/15 bg-white text-[#5A5448] px-3.5 py-1.5 text-xs font-semibold hover:border-[#15140F]/40 hover:text-[#15140F] cursor-pointer transition-all active:translate-x-0.5 active:translate-y-0.5"
        >
          <span class="filter-dot w-1.5 h-1.5 rounded-full bg-[#15140F]/20"></span>
          <span>[ 枕头硬垫辅助推荐 ]</span>
        </button>

        <button
          type="button"
          id="position-reset-filter-btn"
          class="hidden text-xs text-[#8B8676] hover:text-[#15140F] underline cursor-pointer ml-1"
        >
          重置筛选
        </button>
      </div>
    </section>

    {/* 8 大体位卡片网格 (Card Grid) */}
    <section class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="position-cards-grid">
        {POSITION_METHODS.map((pos) => {
          const filterTags = getFilterTags(pos);
          return (
            <article
              class="position-card flex flex-col justify-between rounded-2xl border border-[#15140F]/15 bg-[#FAF8F5]/30 p-5 shadow-[2px_2px_0_rgba(21,20,15,0.06)] hover:border-[#15140F]/30 hover:shadow-[3px_3px_0_rgba(21,20,15,0.12)] transition-all"
              data-position-id={pos.id}
              data-filter-tags={filterTags.join(' ')}
            >
              <div class="space-y-4">
                {/* 卡片顶部类别与标题 */}
                <div class="space-y-1.5">
                  <div class="flex items-center justify-between gap-2">
                    <span class="rounded-full border border-[#15140F]/15 bg-stone-100 px-2.5 py-0.5 text-[10px] font-mono font-bold text-[#5A5448]">
                      [ {categoryBadgeMap[pos.category]} ]
                    </span>
                    <span class="text-[10px] font-mono text-[#8B8676]">
                      ID: {pos.id}
                    </span>
                  </div>
                  <h4 class="text-base font-extrabold text-[#15140F] tracking-tight leading-snug">
                    {pos.name}
                  </h4>
                  <p class="text-[11px] font-mono text-[#8B8676] truncate" title={pos.en_name}>
                    {pos.en_name}
                  </p>
                </div>

                {/* 3 重核心生理参数条 */}
                <div class="rounded-xl border border-[#15140F]/10 bg-white p-3 space-y-2.5 text-xs">
                  {/* 阴蒂可达度 */}
                  <div class="space-y-1">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] text-[#5A5448] font-medium">阴蒂可达度 (Clitoral Access)</span>
                      <span class:list={[
                        "font-mono text-[10px] font-bold px-1.5 py-0.2 rounded-sm",
                        pos.clitoral_access === 'high' ? "bg-emerald-50 text-emerald-700" :
                        pos.clitoral_access === 'moderate' ? "bg-teal-50 text-teal-700" : "bg-stone-100 text-[#5A5448]"
                      ]}>
                        {pos.clitoral_access === 'high' ? 'High · 充分贴合' :
                         pos.clitoral_access === 'moderate' ? 'Moderate · 需外力辅助' : 'Low · 间接/需道具'}
                      </span>
                    </div>
                    <div class="grid grid-cols-3 gap-1 h-1.5 bg-[#FAF8F5] rounded-full p-0.5">
                      <div class:list={["h-full rounded-full", pos.clitoral_access === 'high' || pos.clitoral_access === 'moderate' || pos.clitoral_access === 'low' ? 'bg-emerald-600' : 'bg-stone-200']}></div>
                      <div class:list={["h-full rounded-full", pos.clitoral_access === 'high' || pos.clitoral_access === 'moderate' ? 'bg-emerald-600' : 'bg-stone-200']}></div>
                      <div class:list={["h-full rounded-full", pos.clitoral_access === 'high' ? 'bg-emerald-600' : 'bg-stone-200']}></div>
                    </div>
                  </div>

                  {/* 宫颈碰撞风险 */}
