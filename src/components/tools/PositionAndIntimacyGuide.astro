                    </div>

                    {/* 局限 */}
                    <div class="space-y-1">
                      <span class="font-bold text-amber-800 flex items-center gap-1">
                        <span>[ 潜在局限 CONS ]</span>
                      </span>
                      <ul class="space-y-1 pl-3 text-[#5A5448] list-disc leading-relaxed">
                        {pos.cons.map((con) => (
                          <li>{con}</li>
                        ))}
                      </ul>
                    </div>

                    {/* 沟通提示 */}
                    <div class="space-y-1 rounded-lg border border-[#15140F]/10 bg-white p-2 text-[#15140F]">
                      <span class="font-bold text-[10px] text-rose-700 block">
                        [ 伴侣沟通无障碍示范 ]
                      </span>
                      <p class="italic text-[#2A2620] leading-relaxed">
                        {pos.communication_tip}
                      </p>
                    </div>
                  </div>
                </details>
              </div>

              {/* 卡片底部操作与科普链接 */}
              <div class="pt-4 border-t border-[#15140F]/10 space-y-2 mt-4">
                <div class="flex items-center justify-between">
                  <a
                    href={`${base}articles/${pos.related_article}/`}
                    class="inline-flex items-center gap-1 text-xs font-bold text-rose-600 hover:text-rose-800 hover:underline"
                  >
