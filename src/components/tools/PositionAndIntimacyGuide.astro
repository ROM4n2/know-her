                    <div class="flex items-center justify-between">
                      <span class="text-[11px] text-[#5A5448] font-medium">宫颈碰撞风险 (Cervical Collision)</span>
                      <span class:list={[
                        "font-mono text-[10px] font-bold px-1.5 py-0.2 rounded-sm",
                        pos.cervical_collision_risk === 'low' ? "bg-emerald-50 text-emerald-700" :
                        pos.cervical_collision_risk === 'moderate' ? "bg-amber-50 text-amber-700" : "bg-rose-50 text-rose-700"
                      ]}>
                        {pos.cervical_collision_risk === 'low' ? 'Low · 极低/安全缓冲' :
                         pos.cervical_collision_risk === 'moderate' ? 'Moderate · 需克制冲程' : 'High · 深部冲撞预警'}
                      </span>
                    </div>
                    <div class="grid grid-cols-3 gap-1 h-1.5 bg-[#FAF8F5] rounded-full p-0.5">
                      <div class:list={["h-full rounded-full", pos.cervical_collision_risk === 'low' ? 'bg-emerald-600' : pos.cervical_collision_risk === 'moderate' ? 'bg-amber-500' : 'bg-rose-500']}></div>
                      <div class:list={["h-full rounded-full", pos.cervical_collision_risk === 'moderate' ? 'bg-amber-500' : pos.cervical_collision_risk === 'high' ? 'bg-rose-500' : 'bg-stone-200']}></div>
                      <div class:list={["h-full rounded-full", pos.cervical_collision_risk === 'high' ? 'bg-rose-500' : 'bg-stone-200']}></div>
                    </div>
                  </div>

                  {/* 体能消耗等级 */}
                  <div class="space-y-1">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] text-[#5A5448] font-medium">体能消耗等级 (Energy Expenditure)</span>
                      <span class:list={[
                        "font-mono text-[10px] font-bold px-1.5 py-0.2 rounded-sm",
                        pos.energy_expenditure === 'low' ? "bg-emerald-50 text-emerald-700" :
                        pos.energy_expenditure === 'moderate' ? "bg-amber-50 text-amber-700" : "bg-rose-50 text-rose-700"
                      ]}>
                        {pos.energy_expenditure === 'low' ? 'Low · 轻度省力' :
                         pos.energy_expenditure === 'moderate' ? 'Moderate · 核心负荷' : 'High · 高肌力消耗'}
                      </span>
                    </div>
                    <div class="grid grid-cols-3 gap-1 h-1.5 bg-[#FAF8F5] rounded-full p-0.5">
                      <div class:list={["h-full rounded-full", pos.energy_expenditure === 'low' ? 'bg-emerald-600' : pos.energy_expenditure === 'moderate' ? 'bg-amber-500' : 'bg-rose-500']}></div>
                      <div class:list={["h-full rounded-full", pos.energy_expenditure === 'moderate' ? 'bg-amber-500' : pos.energy_expenditure === 'high' ? 'bg-rose-500' : 'bg-stone-200']}></div>
                      <div class:list={["h-full rounded-full", pos.energy_expenditure === 'high' ? 'bg-rose-500' : 'bg-stone-200']}></div>
                    </div>
                  </div>
                </div>

                {/* 力学特征标签: 进入轴线与骨盆支撑 */}
                <div class="space-y-2 text-xs">
                  <div class="rounded-xl border border-[#15140F]/10 bg-white p-2.5 space-y-1">
                    <span class="text-[10px] font-mono font-bold text-rose-700 uppercase tracking-wider block">
                      进入轴线力学 (Coital Angle)
                    </span>
                    <p class="text-[11px] text-[#2A2620] leading-relaxed">
                      {pos.coital_angle_desc}
                    </p>
                  </div>
                  <div class="rounded-xl border border-[#15140F]/10 bg-white p-2.5 space-y-1">
                    <span class="text-[10px] font-mono font-bold text-emerald-800 uppercase tracking-wider block">
                      骨盆与支点改良 (Pelvic Support)
                    </span>
                    <p class="text-[11px] text-[#2A2620] leading-relaxed">
                      {pos.pelvic_support_advice}
                    </p>
                  </div>
                </div>

                {/* 可展开生理利弊与沟通提示 */}
                <details class="group rounded-xl border border-[#15140F]/10 bg-white overflow-hidden text-xs">
                  <summary class="cursor-pointer p-3 font-bold text-[#15140F] flex items-center justify-between hover:bg-[#FAF8F5] transition-colors select-none">
                    <span class="flex items-center gap-1.5 text-xs">
                      <span class="font-mono text-[10px] text-rose-600 font-bold">[+]</span>
                      <span>展开核心优势、局限与伴侣沟通语</span>
                    </span>
                    <svg class="w-4 h-4 text-[#8B8676] group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                  </summary>
                  <div class="border-t border-[#15140F]/10 p-3 space-y-3 bg-[#FAF8F5]/40 text-[11px]">
                    {/* 优势 */}
                    <div class="space-y-1">
