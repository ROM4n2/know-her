---
/**
 * ReportDecoder.astro — 妇科检查报告通俗解码台
 * 遵循 FIGO / ACOG / 默沙东大众版临床循证标准
 * 纯前端离线点选运行，零化验单数据上传，无原生彩色 Emoji
 */
import {
  LAB_REPORT_CATEGORIES,
  type LabManagementTier,
} from '../../data/labReportDecoder';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// 站内科普文章标题映射表
const articleTitleMap: Record<string, string> = {
  'body-bacterial-vaginosis': '细菌性阴道病与阴道菌群科普',
  'body-vaginal-yeast-infection': '外阴阴道假丝酵母菌病 (霉菌) 循证防治',
  'body-endometriosis': '痛经与盆腔痛应对指南 (含内膜异位症与盆腔积液)',
  'abnormal-uterine-bleeding': '异常子宫出血 (AUB) FIGO 排查指南',
  'normal-menstrual-cycle': '月经四大指标与正常生理周期',
  'body-hpv-vaccine-screening': 'HPV 疫苗与宫颈癌三阶梯筛查指南',
};

// 临床处置分级样式配置
function getTierStyle(tier: LabManagementTier) {
  switch (tier) {
    case 'normal_physiologic':
      return {
        label: '[ 正常生理现象 ]',
        badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-300',
        dotClass: 'bg-emerald-500',
      };
    case 'routine_monitoring':
      return {
        label: '[ 建议择期复查 ]',
        badgeClass: 'bg-amber-50 text-amber-800 border-amber-300',
        dotClass: 'bg-amber-500',
      };
    case 'specialist_consult':
      return {
        label: '[ 建议公立专科门诊 ]',
        badgeClass: 'bg-rose-50 text-rose-700 border-rose-300',
        dotClass: 'bg-rose-600',
      };
  }
}

// 默认首屏选中第一个类别的首个指标
const firstCategory = LAB_REPORT_CATEGORIES[0];
const firstItem = firstCategory.items[0];
const firstTier = getTierStyle(firstItem.management_tier);
---

<div
  id="report-decoder-root"
  class:list={[
    "rounded-3xl border border-[#15140F]/15 bg-white p-6 sm:p-8 shadow-[3px_3px_0_rgba(21,20,15,0.08)] space-y-8",
    className
  ]}
>
  {/* 顶部标题区 */}
  <header class="border-b border-[#15140F]/10 pb-5 space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#15140F] text-white shadow-2xs">
          <svg class="w-5 h-5 text-rose-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </span>
        <div>
          <h2 class="text-lg sm:text-xl font-extrabold text-[#15140F] tracking-tight">
            [ 妇科检查报告通俗解码台 ]
          </h2>
          <p class="text-xs text-[#5A5448]">
            生僻医学名词制造恐慌？基于 FIGO 与 ACOG 临床循证标准，把白带常规、妇科超声、TCT、HPV 与早孕指标翻译为通俗人话，曝光黑心机构过度医疗陷阱。
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 text-[11px] font-mono">
        <span class="rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 font-medium text-emerald-800">
          FIGO / ACOG 循证
        </span>
        <span class="rounded-full bg-stone-100 border border-stone-200 px-2.5 py-0.5 font-medium text-[#5A5448]">
          本地离线无痕
        </span>
      </div>
    </div>
  </header>

  {/* 4 大报告类别选项卡 */}
  <section class="space-y-3">
    <div class="flex items-center justify-between border-b border-[#15140F]/10 pb-2">
      <div class="flex items-center gap-2">
        <span class="rounded-sm bg-[#15140F] px-1.5 py-0.5 text-[10px] font-mono font-bold text-white uppercase tracking-wider">
          STEP 01
        </span>
        <h3 class="text-sm sm:text-base font-bold text-[#15140F]">
          选择化验单与检查类别（4 大核心检查域）
        </h3>
      </div>
      <span class="text-xs text-[#8B8676]">单选切换分类</span>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3" id="decoder-category-tabs">
      {LAB_REPORT_CATEGORIES.map((cat, idx) => (
        <button
          type="button"
          data-category-id={cat.id}
          class:list={[
            "decoder-category-tab text-left p-3 sm:p-3.5 rounded-2xl border transition-all cursor-pointer relative",
            idx === 0
              ? "border-[#15140F] bg-[#15140F] text-white shadow-[2px_2px_0_rgba(21,20,15,1)]"
              : "border-[#15140F]/15 bg-[#FAF8F5] text-[#15140F] hover:border-[#15140F]/40 active:translate-x-0.5 active:translate-y-0.5"
          ]}
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class:list={[
              "decoder-tab-badge text-[10px] font-mono px-2 py-0.5 rounded-full font-bold",
              idx === 0 ? "bg-white/20 text-white" : "bg-[#15140F]/10 text-[#5A5448]"
            ]}>
              {cat.badge}
            </span>
            <span class:list={[
              "decoder-tab-indicator w-2 h-2 rounded-full",
              idx === 0 ? "bg-rose-400" : "bg-transparent"
            ]}></span>
          </div>
          <div class="font-bold text-xs sm:text-sm tracking-tight truncate">
            {cat.name}
          </div>
          <div class:list={[
            "decoder-tab-count text-[11px] font-mono mt-0.5",
            idx === 0 ? "text-white/70" : "text-[#8B8676]"
          ]}>
            共 {cat.items.length} 项关键指标
          </div>
        </button>
      ))}
    </div>

    {/* 分类说明栏 */}
    <div id="decoder-category-banner" class="rounded-xl border border-[#15140F]/10 bg-[#FAF8F5] p-3 text-xs text-[#5A5448] flex items-center justify-between">
      <span id="decoder-category-desc">{firstCategory.description}</span>
      <span class="font-mono text-[10px] text-[#8B8676] uppercase hidden sm:inline">[ FIGO / ACOG 循证解析 ]</span>
    </div>
  </section>

  {/* 指标卡片网格 */}
  <section class="space-y-3">
    <div class="flex items-center justify-between border-b border-[#15140F]/10 pb-2">
      <div class="flex items-center gap-2">
        <span class="rounded-sm bg-[#15140F] px-1.5 py-0.5 text-[10px] font-mono font-bold text-white uppercase tracking-wider">
          STEP 02
        </span>
        <h3 class="text-sm sm:text-base font-bold text-[#15140F]">
          定位化验单异常字样或疑虑指标
        </h3>
      </div>
      <span class="text-xs text-[#8B8676]">点击卡片展开详情</span>
    </div>

    <div id="decoder-items-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {LAB_REPORT_CATEGORIES.flatMap((cat) => cat.items).map((item, itemIdx) => {
        const tier = getTierStyle(item.management_tier);
        const isFirst = item.id === firstItem.id;
        const isCurrentCat = item.category === firstCategory.id;
        return (
          <button
            type="button"
            data-item-id={item.id}
            data-category-id={item.category}
            class:list={[
              "decoder-item-card text-left p-3.5 rounded-2xl border transition-all cursor-pointer relative flex flex-col justify-between gap-2.5",
              isFirst
                ? "border-[#15140F] bg-white ring-2 ring-[#15140F] shadow-[2px_2px_0_rgba(21,20,15,1)]"
                : "border-[#15140F]/15 bg-white/90 hover:border-[#15140F]/40 hover:bg-white shadow-2xs",
              !isCurrentCat && "hidden"
            ]}
          >
            <div class="space-y-1.5">
              <div class="flex items-center justify-between gap-1">
                <span class:list={[
                  "inline-flex items-center gap-1 text-[10px] font-mono font-bold px-2 py-0.5 rounded-full border",
                  tier.badgeClass
                ]}>
                  <span class:list={["w-1.5 h-1.5 rounded-full", tier.dotClass]}></span>
                  <span>{tier.label}</span>
                </span>
                <span class="text-[10px] font-mono text-[#8B8676]">{itemIdx + 1 < 10 ? `0${itemIdx + 1}` : itemIdx + 1}</span>
              </div>
              <h4 class="font-bold text-xs sm:text-sm text-[#15140F] tracking-tight leading-snug line-clamp-1">
                {item.name}
              </h4>
              <p class="font-mono text-[10px] text-[#8B8676] truncate">
                {item.en_name}
              </p>
            </div>
            <p class="text-[11px] text-[#5A5448] line-clamp-2 leading-relaxed">
              {item.plain_language_meaning}
            </p>
          </button>
        );
      })}
    </div>
  </section>

  {/* 详细解读面板 */}
  <section
    id="decoder-detail-panel"
    class="rounded-2xl border-2 border-[#15140F] bg-[#FAF8F5] p-5 sm:p-7 shadow-[3px_3px_0_rgba(21,20,15,1)] space-y-6"
  >
    {/* 头部：指标名称、英文术语、分级徽标 */}
    <div class="border-b border-[#15140F]/15 pb-4 space-y-2">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="rounded-sm bg-[#15140F] px-1.5 py-0.5 text-[10px] font-mono font-bold text-white uppercase tracking-wider">
            [ 报告精解 ]
          </span>
          <span
            id="decoder-item-tier-badge"
            class:list={[
              "inline-flex items-center gap-1 text-xs font-mono font-bold px-2.5 py-0.5 rounded-full border",
              firstTier.badgeClass
            ]}
          >
            {firstTier.label}
          </span>
        </div>
        <span class="text-[11px] font-mono text-[#8B8676]">[ 离线纯前端解析 · 零云端上传 ]</span>
      </div>
      <h3
        id="decoder-item-title"
        class="text-lg sm:text-2xl font-extrabold text-[#15140F] tracking-tight"
      >
        {firstItem.name}
      </h3>
      <p
        id="decoder-item-en-name"
        class="font-mono text-xs sm:text-sm text-[#8B8676]"
      >
        {firstItem.en_name}
      </p>
    </div>

    {/* 01: 通俗人话诊断 */}
    <div class="space-y-2 bg-white p-4 sm:p-5 rounded-xl border border-[#15140F]/10 shadow-2xs">
      <div class="flex items-center gap-2 text-emerald-800 font-bold text-xs sm:text-sm font-mono tracking-tight">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        <span>[ 01 // 报告通俗人话诊断 ]</span>
      </div>
      <p
        id="decoder-plain-meaning"
        class="text-xs sm:text-sm text-[#15140F] leading-relaxed font-medium"
      >
        {firstItem.plain_language_meaning}
      </p>
    </div>

    {/* 02: 临床循证定义 */}
    <div class="space-y-2 bg-white/70 p-4 sm:p-5 rounded-xl border border-[#15140F]/10">
      <div class="flex items-center gap-2 text-[#5A5448] font-bold text-xs sm:text-sm font-mono tracking-tight">
        <span class="w-1.5 h-1.5 rounded-full bg-[#5A5448]"></span>
        <span>[ 02 // 临床循证定义 ]</span>
      </div>
      <p
        id="decoder-clinical-def"
        class="text-xs sm:text-sm text-[#5A5448] leading-relaxed"
      >
        {firstItem.clinical_definition}
      </p>
    </div>

    {/* 03: 过度医疗与虚假宣传防坑警示框 */}
    <div class="border-2 border-rose-300 bg-rose-50/70 p-4 sm:p-5 rounded-2xl space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-rose-800 font-bold text-xs sm:text-sm font-mono tracking-tight">
          <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
          <span>[ 03 // 过度医疗与虚假宣传防坑警示 ]</span>
        </div>
        <span class="text-[10px] font-mono text-rose-600 font-bold">[ 临床骗局曝光 ]</span>
      </div>
      <div id="decoder-redflags-list" class="space-y-2.5">
        {firstItem.overtreatment_redflags.map((rf) => (
          <div class="text-xs sm:text-sm text-rose-950 leading-relaxed bg-white/90 p-3 rounded-xl border border-rose-200/80 shadow-2xs">
            {rf}
          </div>
        ))}
      </div>
    </div>

    {/* 04: 就诊追问清单 */}
    <div class="bg-white p-4 sm:p-5 rounded-xl border border-[#15140F]/10 space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-[#15140F] font-bold text-xs sm:text-sm font-mono tracking-tight">
          <svg class="w-4 h-4 text-[#15140F]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
          </svg>
          <span>[ 04 // 门诊就诊追问清单 ]</span>
        </div>
        <span class="text-[10px] font-mono text-[#8B8676]">[ 面诊结构化沟通 ]</span>
      </div>
      <div id="decoder-questions-list" class="space-y-2">
        {firstItem.doctor_questions.map((q) => (
          <div class="text-xs sm:text-sm text-[#2A2620] leading-relaxed bg-[#FAF8F5] p-3 rounded-xl border border-[#15140F]/10 font-medium">
            {q}
          </div>
        ))}
      </div>
    </div>

    {/* 05: 站内循证深度阅读 */}
    <div id="decoder-article-container" class="space-y-2">
      <div class="text-[11px] font-mono text-[#8B8676] uppercase">
        [ 05 // 站内循证深度阅读 ]
      </div>
      <div>
        <a
          id="decoder-article-link"
          href={`${base}articles/${firstItem.related_article}/`}
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-rose-700 hover:text-rose-900 hover:underline bg-rose-50/60 px-3.5 py-2 rounded-xl border border-rose-200/60 transition-colors"
        >
          <span>阅读相关深度指南：《{articleTitleMap[firstItem.related_article] || firstItem.related_article}》 →</span>
        </a>
      </div>
    </div>

    {/* 操作按钮区 */}
    <div class="pt-4 border-t border-[#15140F]/10 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2.5">
        <button
          id="decoder-copy-btn"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-full border border-[#15140F] bg-[#15140F] px-4 py-2 text-xs font-semibold text-white hover:bg-stone-800 active:translate-x-0.5 active:translate-y-0.5 transition-all shadow-[2px_2px_0_rgba(21,20,15,0.8)] cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-rose-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.849A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.599m7.332 0c.055.194.084.4.084.615v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.215.03-.42.084-.615m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
          </svg>
          <span>[ 复制通俗诊断与追问清单 ]</span>
        </button>
        <button
          id="decoder-export-png-btn"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-full border border-[#15140F]/20 bg-white px-4 py-2 text-xs font-semibold text-[#15140F] hover:border-[#15140F] hover:bg-[#FAF8F5] active:translate-x-0.5 active:translate-y-0.5 transition-all shadow-2xs cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-[#5A5448]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          <span id="decoder-export-btn-text">[ 导出纸墨便签长图 (PNG) ]</span>
        </button>
      </div>
      <span id="decoder-action-status" class="text-xs text-[#8B8676] font-mono"></span>
    </div>
  </section>
</div>

<script>
  import {
    LAB_REPORT_CATEGORIES,
    type LabReportItem,
    type LabManagementTier,
  } from '../../data/labReportDecoder';
  import { exportMemoAsImage } from '../../lib/ui/memoImageExporter';

  const base = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

  const articleTitleMap: Record<string, string> = {
    'body-bacterial-vaginosis': '细菌性阴道病与阴道菌群科普',
    'body-vaginal-yeast-infection': '外阴阴道假丝酵母菌病 (霉菌) 循证防治',
    'body-endometriosis': '痛经与盆腔痛应对指南 (含内膜异位症与盆腔积液)',
    'abnormal-uterine-bleeding': '异常子宫出血 (AUB) FIGO 排查指南',
    'normal-menstrual-cycle': '月经四大指标与正常生理周期',
    'body-hpv-vaccine-screening': 'HPV 疫苗与宫颈癌三阶梯筛查指南',
  };

  function getTierMeta(tier: LabManagementTier) {
    switch (tier) {
      case 'normal_physiologic':
        return {
          label: '[ 正常生理现象 ]',
          badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-300',
        };
      case 'routine_monitoring':
        return {
          label: '[ 建议择期复查 ]',
          badgeClass: 'bg-amber-50 text-amber-800 border-amber-300',
        };
      case 'specialist_consult':
        return {
          label: '[ 建议公立专科门诊 ]',
          badgeClass: 'bg-rose-50 text-rose-700 border-rose-300',
        };
    }
  }

  // 建立 item 映射索引
  const allItemsMap = new Map<string, LabReportItem>();
  LAB_REPORT_CATEGORIES.forEach((cat) => {
    cat.items.forEach((item) => {
      allItemsMap.set(item.id, item);
    });
  });

  const catMap = new Map(LAB_REPORT_CATEGORIES.map((c) => [c.id, c]));

  let currentItem: LabReportItem | undefined = LAB_REPORT_CATEGORIES[0].items[0];

  const categoryTabs = document.querySelectorAll<HTMLButtonElement>('.decoder-category-tab');
  const itemCards = document.querySelectorAll<HTMLButtonElement>('.decoder-item-card');
  const categoryDescEl = document.getElementById('decoder-category-desc');

  // 详情面板 DOM 节点
  const titleEl = document.getElementById('decoder-item-title');
  const enNameEl = document.getElementById('decoder-item-en-name');
  const tierBadgeEl = document.getElementById('decoder-item-tier-badge');
  const plainMeaningEl = document.getElementById('decoder-plain-meaning');
  const clinicalDefEl = document.getElementById('decoder-clinical-def');
  const redflagsListEl = document.getElementById('decoder-redflags-list');
  const questionsListEl = document.getElementById('decoder-questions-list');
  const articleLinkEl = document.getElementById('decoder-article-link') as HTMLAnchorElement | null;
  const copyBtn = document.getElementById('decoder-copy-btn');
  const exportBtn = document.getElementById('decoder-export-png-btn') as HTMLButtonElement | null;
  const exportBtnText = document.getElementById('decoder-export-btn-text');
  const statusEl = document.getElementById('decoder-action-status');

  function setStatus(msg: string) {
    if (!statusEl) return;
    statusEl.textContent = msg;
    window.setTimeout(() => {
      if (statusEl.textContent === msg) {
        statusEl.textContent = '';
      }
    }, 2800);
  }

  function renderDetail(item: LabReportItem) {
    currentItem = item;
    const tierMeta = getTierMeta(item.management_tier);

    if (titleEl) titleEl.textContent = item.name;
    if (enNameEl) enNameEl.textContent = item.en_name;

    if (tierBadgeEl) {
      tierBadgeEl.textContent = tierMeta.label;
      tierBadgeEl.className = `inline-flex items-center gap-1 text-xs font-mono font-bold px-2.5 py-0.5 rounded-full border ${tierMeta.badgeClass}`;
    }

    if (plainMeaningEl) plainMeaningEl.textContent = item.plain_language_meaning;
    if (clinicalDefEl) clinicalDefEl.textContent = item.clinical_definition;

    // 安全渲染防坑警示 (使用 replaceChildren + createElement，严格杜绝 innerHTML)
    if (redflagsListEl) {
      const rfNodes = item.overtreatment_redflags.map((rf) => {
        const div = document.createElement('div');
        div.className =
          'text-xs sm:text-sm text-rose-950 leading-relaxed bg-white/90 p-3 rounded-xl border border-rose-200/80 shadow-2xs';
        div.textContent = rf;
        return div;
      });
      redflagsListEl.replaceChildren(...rfNodes);
    }

    // 安全渲染就诊追问清单 (使用 replaceChildren + createElement，严格杜绝 innerHTML)
    if (questionsListEl) {
      const qNodes = item.doctor_questions.map((q) => {
        const div = document.createElement('div');
        div.className =
          'text-xs sm:text-sm text-[#2A2620] leading-relaxed bg-[#FAF8F5] p-3 rounded-xl border border-[#15140F]/10 font-medium';
        div.textContent = q;
        return div;
      });
      questionsListEl.replaceChildren(...qNodes);
    }

    // 站内阅读文章链接
    if (articleLinkEl) {
      articleLinkEl.href = `${base}articles/${item.related_article}/`;
      const title = articleTitleMap[item.related_article] || item.related_article;
      articleLinkEl.textContent = `阅读相关深度指南：《${title}》 →`;
    }
  }

  function updateActiveCard(itemId: string) {
    itemCards.forEach((card) => {
      const isSelected = card.dataset.itemId === itemId;
      if (isSelected) {
        card.classList.remove('border-[#15140F]/15', 'bg-white/90', 'shadow-2xs');
        card.classList.add(
          'border-[#15140F]',
          'bg-white',
          'ring-2',
          'ring-[#15140F]',
          'shadow-[2px_2px_0_rgba(21,20,15,1)]'
        );
      } else {
        card.classList.remove(
          'border-[#15140F]',
          'ring-2',
          'ring-[#15140F]',
          'shadow-[2px_2px_0_rgba(21,20,15,1)]'
        );
        card.classList.add('border-[#15140F]/15', 'bg-white/90', 'shadow-2xs');
      }
    });
  }

  function switchCategory(catId: string, targetItemId?: string) {
    const cat = catMap.get(catId);
    if (cat && categoryDescEl) {
      categoryDescEl.textContent = cat.description;
    }

    // 更新 Tab 样式
    categoryTabs.forEach((tab) => {
      const isCurrent = tab.dataset.categoryId === catId;
      const badge = tab.querySelector('.decoder-tab-badge');
      const indicator = tab.querySelector('.decoder-tab-indicator');
      const count = tab.querySelector('.decoder-tab-count');

      if (isCurrent) {
        tab.className =
          'decoder-category-tab text-left p-3 sm:p-3.5 rounded-2xl border transition-all cursor-pointer relative border-[#15140F] bg-[#15140F] text-white shadow-[2px_2px_0_rgba(21,20,15,1)]';
        if (badge) badge.className = 'decoder-tab-badge text-[10px] font-mono px-2 py-0.5 rounded-full font-bold bg-white/20 text-white';
        if (indicator) indicator.className = 'decoder-tab-indicator w-2 h-2 rounded-full bg-rose-400';
        if (count) count.className = 'decoder-tab-count text-[11px] font-mono mt-0.5 text-white/70';
      } else {
        tab.className =
          'decoder-category-tab text-left p-3 sm:p-3.5 rounded-2xl border transition-all cursor-pointer relative border-[#15140F]/15 bg-[#FAF8F5] text-[#15140F] hover:border-[#15140F]/40 active:translate-x-0.5 active:translate-y-0.5';
        if (badge) badge.className = 'decoder-tab-badge text-[10px] font-mono px-2 py-0.5 rounded-full font-bold bg-[#15140F]/10 text-[#5A5448]';
        if (indicator) indicator.className = 'decoder-tab-indicator w-2 h-2 rounded-full bg-transparent';
        if (count) count.className = 'decoder-tab-count text-[11px] font-mono mt-0.5 text-[#8B8676]';
      }
    });

    // 过滤卡片列表显示
    itemCards.forEach((card) => {
      if (card.dataset.categoryId === catId) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });

    // 确定选中的 item
    const nextItem =
      (targetItemId && allItemsMap.get(targetItemId)) ||
      (cat && cat.items[0]) ||
      LAB_REPORT_CATEGORIES[0].items[0];

    if (nextItem) {
      updateActiveCard(nextItem.id);
      renderDetail(nextItem);
    }
  }

  // 绑定分类 Tab 事件
  categoryTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const catId = tab.dataset.categoryId;
      if (catId) switchCategory(catId);
    });
  });

  // 绑定指标卡片点击事件
  itemCards.forEach((card) => {
    card.addEventListener('click', () => {
      const itemId = card.dataset.itemId;
      if (!itemId) return;
      const item = allItemsMap.get(itemId);
      if (item) {
        updateActiveCard(itemId);
        renderDetail(item);
      }
    });
  });

  // 复制通俗诊断与追问清单
  copyBtn?.addEventListener('click', async () => {
    if (!currentItem) return;
    const tierMeta = getTierMeta(currentItem.management_tier);
    const text = [
      '========================================',
      '[ know-her · 妇科检查报告通俗解码便签 ]',
      '========================================',
      `【检查项目】${currentItem.name}`,
      `【英文术语】${currentItem.en_name}`,
      `【临床分级】${tierMeta.label}`,
      '',
      '【01 // 通俗人话诊断】',
      currentItem.plain_language_meaning,
      '',
      '【02 // 临床循证定义】',
      currentItem.clinical_definition,
      '',
      '【03 // 过度医疗防坑警示】',
      ...currentItem.overtreatment_redflags.map((rf) => `• ${rf}`),
      '',
      '【04 // 建议向医生确认的重点问题】',
      ...currentItem.doctor_questions.map((q) => `• ${q}`),
      '',
      '----------------------------------------',
      '* 本内容全程由本地浏览器离线解码生成，零个人数据上传。仅供就医沟通准备参考，不替代执业医师诊断意见。',
    ].join('\n');

    try {
      await navigator.clipboard.writeText(text);
      setStatus('[ 已复制通俗诊断与追问清单到剪贴板 ]');
    } catch {
      setStatus('[ 复制失败，请手动选取复制 ]');
    }
  });

  // 导出纸墨长图 PNG
  exportBtn?.addEventListener('click', async () => {
    if (!currentItem) return;
    const originalText = exportBtnText?.textContent ?? '[ 导出纸墨便签长图 (PNG) ]';
    if (exportBtnText) exportBtnText.textContent = '[ 正在生成纸墨长图… ]';
    exportBtn.setAttribute('disabled', 'disabled');

    try {
      const tierMeta = getTierMeta(currentItem.management_tier);
      await exportMemoAsImage({
        title: `妇科报告解码：${currentItem.name}`,
        badge: '[ know-her · 检查报告通俗解码台 ]',
        subtitle: `${currentItem.en_name} · ${tierMeta.label} · 纯前端离线生成`,
        sections: [
          {
            heading: '01 // 通俗人话诊断',
            lines: [currentItem.plain_language_meaning],
          },
          {
            heading: '02 // 临床循证定义',
            lines: [currentItem.clinical_definition],
          },
          {
            heading: '03 // 过度医疗防坑警示',
            lines: currentItem.overtreatment_redflags,
          },
          {
            heading: '04 // 门诊就诊追问清单',
            lines: currentItem.doctor_questions,
          },
        ],
        disclaimer:
          '本解码内容依据 FIGO / ACOG 国际妇产科指南由 know-her 在本地离线生成，零隐私上传，不替代执业医师面诊意见。',
        fileName: `know-her-报告解码-${currentItem.id}`,
      });
      setStatus('[ 便签长图已生成并下载 ]');
    } catch (err) {
      console.error(err);
      setStatus('[ 长图生成失败，请改用文本复制 ]');
    } finally {
      exportBtn.removeAttribute('disabled');
      if (exportBtnText) exportBtnText.textContent = originalText;
    }
  });

  // 挂载全局方法供 URL 调度与跨组件联动调用
  (window as unknown as { selectReportDecoderItem?: (catId?: string | null, itemId?: string | null) => void }).selectReportDecoderItem = function (
    catId?: string | null,
    itemId?: string | null
  ) {
    if (itemId) {
      const item = allItemsMap.get(itemId);
      if (item) {
        switchCategory(item.category, item.id);
        return;
      }
    }
    if (catId && catMap.has(catId)) {
      switchCategory(catId);
    }
  };

  // 检查初始 URL 参数（保障在模块延迟加载与冷启动直链场景下能无竞态激活目标指标）
  try {
    const initParams = new URLSearchParams(window.location.search);
    if (initParams.get('tool') === 'report-decoder') {
      const initCat = initParams.get('category');
      const initItem = initParams.get('item');
      if (initCat || initItem) {
        (window as unknown as { selectReportDecoderItem?: (c?: string | null, i?: string | null) => void }).selectReportDecoderItem?.(initCat, initItem);
      }
    }
  } catch (e) {
    // 忽略异常，降级到默认首选指标
  }
</script>
