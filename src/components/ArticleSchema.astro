---
/**
 * ArticleSchema.astro — Schema.org Article 结构化数据（含原文溯源）
 */
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title: string;
  url: string;
  summary: string;
  pubDate: Date;
  category: string;
  tags: string[];
  source_url: string;
  source_name: string;
  author?: string;
  is_full_text: boolean;
}

const {
  title,
  url,
  summary,
  pubDate,
  category,
  tags,
  source_url,
  source_name,
  author,
  is_full_text,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://know-her.pages.dev');
const isoDate = pubDate.toISOString();

const payload = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': url,
  url,
  headline: title,
  description: summary || SITE_DESCRIPTION,
  datePublished: isoDate,
  dateModified: isoDate,
  inLanguage: 'zh-CN',
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_TITLE,
    url: siteUrl.origin,
  },
  author: {
    '@type': 'Person',
    name: author || source_name || SITE_TITLE,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    url: siteUrl.origin,
  },
  isBasedOn: source_url,
  keywords: tags.join(','),
  articleSection: category,
  isAccessibleForFree: true,
  creativeWorkStatus: is_full_text ? 'FullText' : 'CuratedDigest',
};

const jsonLd = JSON.stringify(payload).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={jsonLd} />
