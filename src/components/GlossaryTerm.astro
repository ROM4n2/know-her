---
/**
 * GlossaryTerm.astro — 文章内专业医学名词交互悬浮释义组件
 * 悬停或点击弹出 80 字简明释义卡片与词典直达链接
 */
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  term: string;
  display?: string;
}

const { term, display } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const allTerms: CollectionEntry<'glossary'>[] = await getCollection('glossary');
const matched = allTerms.find(
  (t) => t.data.term === term || t.id === term || t.data.aliases.includes(term)
);

const termData = matched?.data;
const displayText = display || term;
const glossaryLink = matched ? `${base}glossary/#term-${matched.id}` : `${base}glossary/`;
---

{matched && termData ? (
  <span class="glossary-term-wrapper relative inline-block group cursor-help">
    <span class="border-b border-dashed border-rose-400 text-rose-900 font-medium hover:border-rose-600 transition-colors">
      {displayText}
    </span>
    {/* 悬浮释义卡 */}
    <span class="pointer-events-none group-hover:pointer-events-auto opacity-0 group-hover:opacity-100 transition-all duration-200 absolute bottom-full left-1/2 -translate-x-1/2 mb-2 z-50 w-64 sm:w-72 rounded-xl bg-white border border-gray-200 p-3.5 shadow-lg text-left">
      <span class="flex items-center justify-between gap-1 mb-1">
        <span class="font-bold text-xs sm:text-sm text-gray-900">{termData.term}</span>
        {termData.en_term && (
          <span class="text-[10px] font-mono text-gray-400 truncate max-w-[120px]">
            {termData.en_term}
          </span>
        )}
      </span>
      <span class="block text-xs text-gray-600 leading-relaxed mb-2.5">
        {termData.definition}
      </span>
      <span class="flex items-center justify-between border-t border-gray-100 pt-2 text-[11px] text-gray-400">
        <span class="truncate max-w-[140px]">依据：{termData.source}</span>
        <a
          href={glossaryLink}
          class="font-semibold text-rose-600 hover:text-rose-700 transition-colors flex items-center gap-0.5"
        >
          <span>词典详阅</span>
          <span>↗</span>
        </a>
      </span>
      {/* 箭头装饰 */}
      <span class="absolute top-full left-1/2 -translate-x-1/2 -mt-px border-4 border-transparent border-t-white"></span>
    </span>
  </span>
) : (
  <span>{displayText}</span>
)}
