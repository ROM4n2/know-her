---
/**
 * /glossary/ — 两性健康与医学术语词典
 * 汇聚临床指南、WHO、FIGO 等权威定义的专业医学专有名词速查
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, type CategoryKey } from '../../consts';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const glossaryEntries: CollectionEntry<'glossary'>[] = await getCollection('glossary');

// 按字母正序排序
glossaryEntries.sort((a, b) => {
  if (a.data.letter !== b.data.letter) {
    return a.data.letter.localeCompare(b.data.letter);
  }
  return a.data.term.localeCompare(b.data.term, 'zh-Hans-CN');
});

// 获取所有出现的字母集合
const availableLetters = Array.from(new Set(glossaryEntries.map((e) => e.data.letter))).sort();
---

<Base
  title="两性健康与医学术语词典 | know-her"
  description="收录避孕科学、女性解剖、月经生理、亲密关系等核心专业医学名词，对齐 WHO、FIGO 与默沙东权威定义，降低科普阅读门槛。"
>
  {/* 面包屑导航 */}
  <nav class="mb-6 flex items-center gap-2 text-xs text-gray-400">
    <a href={base} class="hover:text-rose-600 transition-colors">首页</a>
    <span>/</span>
    <span class="font-medium text-gray-700">知识词典</span>
  </nav>

  {/* Header 区域 */}
  <header class="mb-8">
    <div class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 border border-rose-100 px-3 py-1 text-xs font-semibold text-rose-700 mb-3">
      <span>📖</span> 循证定义 · 消除术语认知差
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight leading-snug">
      两性健康与医学术语词典
    </h1>
    <p class="mt-2.5 text-xs sm:text-sm text-gray-600 leading-relaxed max-w-2xl">
      阅读妇科或两性科普遇到“黄体期”、“FIGO标准”、“左炔诺孕酮”一头雾水？本词典为你提供简练、客观、可追溯的权威名词释义，助你轻松跨越医学专业门槛。
    </p>
  </header>

  {/* 实时搜索与筛选控制栏 */}
  <section class="mb-8 space-y-4">
    {/* 搜索框 */}
    <div class="relative">
      <input
        type="search"
        id="glossary-search"
        placeholder="搜索术语名、别名、拼音缩写或释义（如：左炔诺孕酮、COC、黄体、痛经）…"
        class="w-full rounded-2xl border border-[#15140F]/15 bg-white px-4 py-3 pl-10 text-xs sm:text-sm text-[#2A2620] placeholder-[#8B8676] focus:border-rose-500 focus:outline-hidden focus:ring-2 focus:ring-rose-100 shadow-2xs transition-all"
      />
      <span class="absolute left-3.5 top-3.5 text-[#8B8676] text-sm">🔍</span>
      <button
        type="button"
        id="glossary-search-clear"
        class="hidden absolute right-3.5 top-3 text-xs text-[#8B8676] hover:text-[#15140F] cursor-pointer"
      >
        ✕
      </button>
    </div>

    {/* 分类筛选与计数 */}
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex flex-wrap items-center gap-1.5" id="glossary-category-filters">
        <button
          type="button"
          data-category="all"
          class="glossary-cat-btn active rounded-full border border-[#15140F] bg-[#15140F] px-3.5 py-1 font-semibold text-white transition-all cursor-pointer shadow-2xs"
        >
          全部 ({glossaryEntries.length})
        </button>
        {Object.entries(CATEGORIES).map(([key, cat]) => {
          const count = glossaryEntries.filter((e) => e.data.category === key).length;
          return (
            <button
              type="button"
              data-category={key}
              class="glossary-cat-btn rounded-full border border-stone-200 bg-white px-3.5 py-1 font-medium text-[#5A5448] hover:border-stone-300 hover:bg-[#FAF8F5] transition-all cursor-pointer"
            >
              {cat.label} ({count})
            </button>
          );
        })}
      </div>

      <div class="text-[#8B8676] text-xs font-mono">
        共收录 <span id="glossary-count" class="font-bold text-[#15140F]">{glossaryEntries.length}</span> 条专有名词
      </div>
    </div>

    {/* 字母快速索引条 */}
    <div class="flex flex-wrap items-center gap-1 p-2 rounded-xl bg-[#FAF8F5] border border-[#15140F]/10 text-xs">
      <span class="text-[#8B8676] font-mono mr-1 text-[11px]">首字母：</span>
      <button
        type="button"
        data-letter="all"
        class="glossary-letter-btn active px-2 py-0.5 rounded font-mono font-bold text-rose-700 bg-rose-100 cursor-pointer transition-colors"
      >
        ALL
      </button>
      {availableLetters.map((letter) => (
        <button
          type="button"
          data-letter={letter}
          class="glossary-letter-btn px-2 py-0.5 rounded font-mono font-medium text-[#5A5448] hover:text-rose-600 hover:bg-white cursor-pointer transition-colors"
        >
          {letter}
        </button>
      ))}
    </div>
  </section>

  {/* 词条卡片网格 */}
  <section>
    <div id="glossary-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {glossaryEntries.map((item) => {
        const catInfo = CATEGORIES[item.data.category as CategoryKey] ?? {
          label: item.data.category,
          cls: 'bg-gray-100 text-gray-700 border-gray-200',
        };
        return (
          <article
            class="glossary-card group relative flex flex-col justify-between rounded-2xl border border-[#15140F]/12 bg-white p-5 shadow-[0_2px_4px_rgba(21,20,15,0.04)] hover:shadow-[3px_3px_0_rgba(21,20,15,0.1)] hover:border-rose-400 hover:-translate-y-0.5 transition-all"
            data-term={item.data.term.toLowerCase()}
            data-en={item.data.en_term?.toLowerCase() || ''}
            data-aliases={item.data.aliases.join(',').toLowerCase()}
            data-category={item.data.category}
            data-letter={item.data.letter}
            data-definition={item.data.definition.toLowerCase()}
            id={`term-${item.id}`}
          >
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg bg-[#15140F] text-white text-xs font-bold font-mono shadow-2xs">
                    {item.data.letter}
                  </span>
                  <h2 class="text-base sm:text-lg font-bold text-[#15140F] group-hover:text-rose-700 transition-colors">
                    {item.data.term}
                  </h2>
                </div>
                <span class={`rounded-full border px-2 py-0.5 text-[11px] font-medium shrink-0 ${catInfo.cls}`}>
                  {catInfo.label}
                </span>
              </div>

              {item.data.en_term && (
                <div class="text-xs font-mono text-[#8B8676] mb-2">
                  {item.data.en_term}
                </div>
              )}

              <p class="text-xs sm:text-sm text-[#5A5448] leading-relaxed mb-3">
                {item.data.definition}
              </p>

              {item.data.aliases.length > 0 && (
                <div class="flex flex-wrap items-center gap-1 text-[11px] text-[#8B8676] mb-3">
                  <span>别名：</span>
                  {item.data.aliases.map((alias: string) => (
                    <span class="rounded bg-[#FAF8F5] border border-stone-200 px-1.5 py-0.2 text-[#5A5448]">
                      {alias}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <div class="pt-3 border-t border-stone-100 flex items-center justify-between text-xs text-[#8B8676] mt-2">
              <span class="truncate max-w-[200px]" title={item.data.source}>
                依据：{item.data.source}
              </span>
              {item.data.related_article && (
                <a
                  href={`${base}articles/${item.data.related_article}/`}
                  class="font-semibold text-rose-600 hover:text-rose-700 transition-colors shrink-0 flex items-center gap-0.5"
                >
                  <span>延伸阅读</span>
                  <span>→</span>
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>

    {/* 空状态反馈 */}
    <div id="glossary-empty" class="hidden text-center py-16 text-gray-400 space-y-2">
      <span class="text-3xl block">🔍</span>
      <p class="text-sm font-medium">未找到符合条件的医学术语</p>
      <p class="text-xs text-gray-400">试试其他关键词或切换分类筛选</p>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    const searchInput = document.getElementById('glossary-search');
    const clearBtn = document.getElementById('glossary-search-clear');
    const catButtons = document.querySelectorAll('.glossary-cat-btn');
    const letterButtons = document.querySelectorAll('.glossary-letter-btn');
    const cards = document.querySelectorAll('.glossary-card');
    const countDisplay = document.getElementById('glossary-count');
    const emptyState = document.getElementById('glossary-empty');

    let activeCategory = 'all';
    let activeLetter = 'all';
    let searchQuery = '';

    function filterCards() {
      let visibleCount = 0;
      const q = searchQuery.toLowerCase().trim();

      cards.forEach((card) => {
        const term = card.dataset.term || '';
        const en = card.dataset.en || '';
        const aliases = card.dataset.aliases || '';
        const definition = card.dataset.definition || '';
        const category = card.dataset.category || '';
        const letter = card.dataset.letter || '';

        // 1. 分类匹配
        const matchCat = activeCategory === 'all' || category === activeCategory;

        // 2. 字母匹配
        const matchLetter = activeLetter === 'all' || letter === activeLetter;

        // 3. 搜索词匹配（匹配名称、英文、别名或释义）
        const matchQuery =
          !q ||
          term.includes(q) ||
          en.includes(q) ||
          aliases.includes(q) ||
          definition.includes(q);

        if (matchCat && matchLetter && matchQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countDisplay) {
        countDisplay.textContent = visibleCount;
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    // 搜索事件
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      if (clearBtn) {
        clearBtn.classList.toggle('hidden', !searchQuery);
      }
      filterCards();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchQuery = '';
        clearBtn.classList.add('hidden');
        filterCards();
      }
    });

    // 分类切换
    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => {
          b.classList.remove('active', 'border-gray-900', 'bg-gray-900', 'text-white');
          b.classList.add('border-gray-200', 'bg-white', 'text-gray-600');
        });
        btn.classList.add('active', 'border-gray-900', 'bg-gray-900', 'text-white');
        btn.classList.remove('border-gray-200', 'bg-white', 'text-gray-600');

        activeCategory = btn.dataset.category || 'all';
        filterCards();
      });
    });

    // 字母切换
    letterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        letterButtons.forEach((b) => {
          b.classList.remove('active', 'text-rose-700', 'bg-rose-100', 'font-bold');
          b.classList.add('text-gray-500', 'font-medium');
        });
        btn.classList.add('active', 'text-rose-700', 'bg-rose-100', 'font-bold');
        btn.classList.remove('text-gray-500', 'font-medium');

        activeLetter = btn.dataset.letter || 'all';
        filterCards();
      });
    });

    // 页面初次加载时检查是否有 Hash 定位（如 /glossary/#term-levonorgestrel）
    if (window.location.hash) {
      const targetId = window.location.hash.substring(1);
      const targetElem = document.getElementById(targetId);
      if (targetElem) {
        targetElem.scrollIntoView({ behavior: 'smooth', block: 'center' });
        targetElem.classList.add('ring-2', 'ring-rose-400');
        setTimeout(() => {
          targetElem.classList.remove('ring-2', 'ring-rose-400');
        }, 3000);
      }
    }
  })();
</script>
