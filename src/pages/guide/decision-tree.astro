---
/**
 * /guide/decision-tree/ — “我该怎么办？”紧急状况交互决策树与速查行动指南
 */
import Base from '../../layouts/Base.astro';
import DecisionGuide from '../../components/DecisionGuide.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Base
  title="“我该怎么办？”紧急状况交互决策指南 | know-her"
  description="遇到避孕套破裂滑脱、短效口服避孕药漏服、或突发非经期异常出血？3步内获得基于 WHO 与 FIGO 指南的清晰处置方案与红旗就医警报，零隐私泄露。"
>
  {/* 面包屑导航 */}
  <nav class="mb-6 flex items-center gap-2 text-xs text-gray-400">
    <a href={base} class="hover:text-rose-600 transition-colors">首页</a>
    <span>/</span>
    <span class="text-gray-400">实用指南</span>
    <span>/</span>
    <span class="font-medium text-gray-700">应急处置决策树</span>
  </nav>

  {/* 顶部 Hero Header */}
  <header class="mb-8">
    <div class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 border border-rose-200/80 px-3 py-1 text-xs font-semibold text-rose-700 mb-3 shadow-2xs">
      <span>⚡</span> 突发状况 · 循证行动方案速查
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-[#15140F] tracking-tight leading-snug">
      发生意外先别慌：3 步明确科学应对方案
    </h1>
    <p class="mt-2.5 text-xs sm:text-sm text-[#5A5448] leading-relaxed max-w-2xl">
      避孕失败或突发出血时，焦虑往往源于信息不对称。本决策树严格依据世界卫生组织（WHO）、国际妇产科联合会（FIGO）与默沙东诊疗手册临床共识制定，全程纯客户端运行，绝不记录任何个人隐私。
    </p>
  </header>

  {/* 决策树核心交互组件 */}
  <section class="mb-12">
    <DecisionGuide />
  </section>

  {/* 底部常见急症与公立就诊须知 */}
  <section class="rounded-2xl border border-[#15140F]/15 bg-white p-6 text-xs sm:text-sm space-y-4 shadow-[2px_2px_0_rgba(21,20,15,0.06)]">
    <h3 class="font-bold text-[#15140F] flex items-center gap-1.5 text-sm sm:text-base">
      <span>🏥</span> 紧急就医常识与公立就诊避坑提示
    </h3>
    <ul class="space-y-2 text-[#5A5448] list-disc pl-4 leading-relaxed">
      <li>
        <strong class="text-[#15140F]">认准公立三甲医院</strong>：妇科急症（如怀疑黄体破裂、宫外孕大出血）请直接前往公立三甲或专科妇幼保健院急诊科挂号，切勿相信搜索广告推荐的私立营利性门诊；
      </li>
      <li>
        <strong class="text-[#15140F]">就诊前如实沟通病史</strong>：向分诊护士和接诊医师如实说明最后一次月经时间（LMP）、是否有无保护性接触、有无腹痛部位，不必有害羞顾虑，医生只关心生命安全；
      </li>
      <li>
        <strong class="text-[#15140F]">谨遵 72 小时黄金期</strong>：常规口服紧急避孕药请尽早在 72 小时内服用；若已接近 5 天（120小时），公立医院急诊放置含铜节育环仍是高效的防线。
      </li>
    </ul>
  </section>
</Base>
