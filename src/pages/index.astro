---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import { CATEGORIES, SITE_TITLE, SITE_DESCRIPTION, type CategoryKey } from '../consts';

const entries: CollectionEntry<'articles'>[] = await getCollection('articles');
const articles = entries
  .filter((entry) => !entry.id.startsWith('_'))
  .sort(
    (a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  {/* Slogan & Hero */}
  <section class="mb-8 text-center sm:text-left">
    <div class="inline-flex items-center gap-2 rounded-full bg-rose-50 border border-rose-100 px-3 py-1 text-xs font-medium text-rose-700 mb-3">
      <span>✨</span> 科学 · 自主 · 愉悦探索
    </div>
    <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
      每日性知识与愉悦探索科普
    </h1>
    <p class="mt-3 text-sm sm:text-base text-gray-600 leading-relaxed max-w-2xl">
      避开伪科学与营销套路。每日精选权威科普文章导读，涵盖避孕技巧、愉悦提升、生理机制与亲密沟通。
    </p>
  </section>

  {/* 搜索 */}
  <section class="mb-8" aria-label="站内检索">
    <Search placeholder="搜索避孕、高潮、月经、愉悦技巧…" />
  </section>

  {/* 分类快捷筛选 */}
  <section class="mb-8" aria-label="主题分类">
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="text-gray-400 mr-1">分类：</span>
      {Object.values(CATEGORIES).map((item) => (
        <span class:list={['rounded-full border px-3 py-1 font-medium transition-colors', item.cls]}>
          {item.label}
        </span>
      ))}
    </div>
  </section>

  {/* 精选科普流 */}
  <section aria-label="精选文章列表">
    <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-6">
      <h2 class="text-lg font-bold text-gray-900">最新精选</h2>
      <span class="text-xs text-gray-400">共收录 {articles.length} 篇</span>
    </div>

    {articles.length > 0 ? (
      <div class="space-y-4">
        {articles.map((article) => {
          const cat = CATEGORIES[article.data.category as CategoryKey] ?? {
            label: article.data.category,
            cls: 'bg-gray-100 text-gray-700 border-gray-200',
          };
          const dateStr = article.data.pubDate.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'numeric',
            day: 'numeric',
          });

          return (
            <article class="group rounded-2xl border border-gray-100 bg-white p-5 shadow-xs transition-all hover:border-rose-200 hover:shadow-md">
              <div class="flex flex-wrap items-center gap-2 mb-2 text-xs">
                <span class:list={['rounded-full border px-2.5 py-0.5 font-medium', cat.cls]}>
                  {cat.label}
                </span>
                <span class="rounded-full border border-gray-100 bg-gray-50 px-2 py-0.5 text-gray-500">
                  {article.data.is_full_text ? '📖 全文' : '💡 导读'}
                </span>
                <span class="text-gray-400 ml-auto">
                  {article.data.source_name} · <time datetime={article.data.pubDate.toISOString()}>{dateStr}</time>
                </span>
              </div>

              <h3 class="text-lg font-bold text-gray-900 group-hover:text-rose-600 transition-colors">
                <a href={`/articles/${article.id}/`} class="focus:outline-hidden">
                  {article.data.title}
                </a>
              </h3>

              <p class="mt-2 text-sm text-gray-600 line-clamp-2 leading-relaxed">
                {article.data.summary}
              </p>

              <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-gray-50 pt-3 text-xs">
                <div class="flex flex-wrap gap-1.5">
                  {article.data.tags.map((tag: string) => (
                    <span class="text-gray-400">#{tag}</span>
                  ))}
                </div>
                <a
                  href={`/articles/${article.id}/`}
                  class="font-medium text-rose-600 hover:text-rose-700 transition-colors"
                >
                  阅读导读与直达原文 →
                </a>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-gray-200 bg-white p-8 text-center text-sm text-gray-400">
        暂无文章，内容正在策展中…
      </div>
    )}
  </section>
</Base>
