---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';

/**
 * 词条清单：只列已发布（review_status === 'published'）且非 `_` 前缀模板的词条。
 * 标题取正文首个 H1（frontmatter 无 title），回退 entry.id。
 */
const entries: CollectionEntry<'articles'>[] = await getCollection('articles');
const published = entries
  .filter(
    (entry) =>
      !entry.id.startsWith('_') && entry.data.review_status === 'published',
  )
  .sort((a, b) => {
    const dateA = a.data.review_date ?? a.data.source_snapshot_date;
    const dateB = b.data.review_date ?? b.data.source_snapshot_date;
    if (dateA !== dateB) return dateA < dateB ? 1 : -1;
    return a.id.localeCompare(b.id);
  });

const items = published.map((entry) => {
  const h1 = entry.body?.match(/^#\s+(.+)$/m)?.[1]?.trim();
  return {
    id: entry.id,
    title: h1 || entry.id,
    href: `/articles/${entry.id}/`,
    snapshotDate: entry.data.source_snapshot_date,
  };
});
---
<Base title="know-her">
  <Fragment slot="head">
    <meta
      name="description"
      content="know-her 妇科与性健康科普知识库（建设中）"
    />
  </Fragment>
  <h1 class="text-2xl font-bold">know-her</h1>
  <p class="mt-2 text-gray-700">know-her 妇科与性健康科普知识库（建设中）</p>
  <section class="mt-6" aria-label="站内搜索">
    <Search />
  </section>

  <section class="mt-8" aria-label="词条清单">
    <h2 class="text-lg font-semibold text-gray-900">词条清单</h2>
    {
      items.length > 0 ? (
        <ul class="mt-3 divide-y divide-gray-200 rounded-lg border border-gray-200">
          {items.map((item) => (
            <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3">
              <a
                href={item.href}
                class="text-blue-600 underline underline-offset-2 hover:text-blue-800"
              >
                {item.title}
              </a>
              <span class="flex items-center gap-3 text-xs text-gray-500">
                <time datetime={item.snapshotDate}>
                  快照 {item.snapshotDate}
                </time>
                <span class="rounded-full border border-green-300 bg-green-100 px-2 py-0.5 font-medium text-green-800">
                  已发布
                </span>
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-3 rounded-lg border border-dashed border-gray-300 px-4 py-6 text-sm text-gray-500">
          词条建设中：首批试点词条正在编写与审核，发布后将在此列出。
        </p>
      )
    }
  </section>
</Base>
