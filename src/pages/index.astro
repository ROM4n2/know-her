---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import DailyCard from '../components/DailyCard.astro';
import AmbientHero from '../components/AmbientHero.astro';
import { CATEGORIES, SITE_TITLE, SITE_DESCRIPTION, type CategoryKey } from '../consts';
import { DAILY_QUIZZES, getTodayIndex } from '../data/dailyQuiz';

const entries: CollectionEntry<'articles'>[] = await getCollection('articles');
const articles = entries
  .filter((entry) => !entry.id.startsWith('_'))
  .sort(
    (a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// 确定性计算今日主推词条与关联每日速测
const todayIdx = getTodayIndex(articles.length);
const featuredArticle = articles[todayIdx] ?? articles[0];
const todayQuiz = featuredArticle ? DAILY_QUIZZES[featuredArticle.id] : undefined;
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  {/* Slogan & 极光帘幕有机交互 Hero */}
  <AmbientHero className="mb-8" />

  {/* 今日精选科普与每日速测打卡 */}
  {featuredArticle && <DailyCard article={featuredArticle} quiz={todayQuiz} />}

  {/* 搜索与随机漫游 */}
  <section class="mb-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3" aria-label="站内检索与随机漫游">
    <div class="flex-1">
      <Search placeholder="搜索避孕、高潮、月经、愉悦技巧、知情同意…" />
    </div>
    <button
      type="button"
      id="random-explore-btn"
      class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-[#15140F]/15 bg-white px-3.5 py-2.5 text-xs font-semibold text-[#15140F] shadow-2xs hover:border-rose-400 hover:text-rose-600 active:translate-x-0.5 active:translate-y-0.5 transition-all cursor-pointer whitespace-nowrap"
      title="随机抽一篇科普文章阅读"
    >
      <svg class="w-3.5 h-3.5 text-[#5A5448]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.678 48.678 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 0 0 3.7 3.7 48.656 48.656 0 0 0 7.324 0 4.006 4.006 0 0 0 3.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3-3 3"/>
      </svg>
      <span class="hidden sm:inline">随便逛逛</span>
    </button>
    <a
      href={`${base}guide/decision-tree/`}
      class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-[#15140F] px-4 py-2.5 text-xs font-semibold text-white shadow-[2px_2px_0_rgba(21,20,15,0.25)] hover:bg-rose-600 active:translate-x-0.5 active:translate-y-0.5 transition-all whitespace-nowrap"
      title="遇到避孕或突发出血意外？3步获取循证处置卡"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span>
      <span>应急决策树</span>
    </a>
  </section>

  {/* 分类快捷筛选 */}
  <section class="mb-8" aria-label="主题分类">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      <div class="flex items-center gap-2 overflow-x-auto max-w-full pb-1 sm:pb-0" id="category-filter-bar">
        <span class="text-[#8B8676] mr-1 shrink-0">分类：</span>
        <button
          type="button"
          data-filter="all"
          class="category-btn active rounded-full border border-[#15140F] bg-[#15140F] px-3.5 py-1 font-semibold text-white transition-all cursor-pointer shrink-0 shadow-2xs"
        >
          全部
        </button>
        {Object.entries(CATEGORIES).map(([key, item]) => (
          <button
            type="button"
            data-filter={key}
            class="category-btn rounded-full border border-stone-200 bg-white px-3.5 py-1 font-medium text-[#5A5448] hover:border-stone-300 hover:bg-[#FAF8F5] transition-all cursor-pointer shrink-0"
          >
            {item.label}
          </button>
        ))}
      </div>
      <a
        id="active-category-page-link"
        href="#"
        data-base={base}
        class="hidden text-xs text-rose-600 hover:text-rose-700 font-semibold hover:underline items-center gap-1"
      >
        <span>查看专题独立页</span>
        <span>↗</span>
      </a>
    </div>
  </section>

  {/* 精选科普流 */}
  <section aria-label="精选文章列表">
    <div class="flex items-center justify-between border-b border-[#15140F]/10 pb-3 mb-6">
      <h2 class="text-base sm:text-lg font-bold text-[#15140F]" id="list-heading">最新精选</h2>
      <span class="text-xs font-mono text-[#8B8676]" id="count-indicator">共收录 {articles.length} 篇</span>
    </div>

    {articles.length > 0 ? (
      <div class="space-y-4" id="article-list-container">
        {articles.map((article) => {
          const cat = CATEGORIES[article.data.category as CategoryKey] ?? {
            label: article.data.category,
            cls: 'bg-gray-100 text-gray-700 border-gray-200',
          };
          const dateStr = article.data.pubDate.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'numeric',
            day: 'numeric',
          });
          const tierCls = article.data.evidence_tier === 'A'
            ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
            : 'bg-blue-50 text-blue-800 border-blue-200';

          return (
            <article
              class="article-card group rounded-2xl border border-[#15140F]/12 bg-white p-5 shadow-[0_2px_4px_rgba(21,20,15,0.04)] hover:shadow-[3px_3px_0_rgba(21,20,15,0.1)] hover:border-rose-400 hover:-translate-y-0.5 transition-all"
              data-category={article.data.category}
            >
              <div class="flex flex-wrap items-center gap-2 mb-2.5 text-xs">
                <span class:list={['rounded-full border px-2.5 py-0.5 font-medium', cat.cls]}>
                  {cat.label}
                </span>
                <span class:list={['rounded-full border px-2 py-0.5 text-[11px] font-bold font-mono', tierCls]}>
                  Tier {article.data.evidence_tier}
                </span>
                <span class="rounded-full border border-stone-200 bg-[#FAF8F5] px-2 py-0.5 text-[11px] text-[#5A5448]">
                  {article.data.is_full_text ? '全文收录' : '精选导读'}
                </span>
                <span class="text-[#8B8676] ml-auto text-[11px]">
                  {article.data.source_name} · <time datetime={article.data.pubDate.toISOString()}>{dateStr}</time>
                </span>
              </div>

              <h3 class="text-base sm:text-lg font-bold text-[#15140F] group-hover:text-rose-600 transition-colors leading-snug">
                <a href={`${base}articles/${article.id}/`} class="focus:outline-hidden">
                  {article.data.title}
                </a>
              </h3>

              <p class="mt-2 text-xs sm:text-sm text-[#5A5448] line-clamp-2 leading-relaxed">
                {article.data.summary}
              </p>

              <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-stone-100 pt-3 text-xs">
                <div class="flex flex-wrap gap-1.5">
                  {article.data.tags.map((tag: string) => (
                    <span class="text-[#8B8676] text-[11px]">#{tag}</span>
                  ))}
                </div>
                <a
                  href={`${base}articles/${article.id}/`}
                  class="font-semibold text-rose-600 hover:text-rose-700 transition-colors flex items-center gap-0.5"
                >
                  <span>阅读导读</span>
                  <span>→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-gray-200 bg-white p-8 text-center text-sm text-gray-400">
        暂无文章，内容正在策展中…
      </div>
    )}

    <div id="no-match-alert" class="hidden rounded-2xl border border-dashed border-gray-200 bg-white p-8 text-center text-sm text-gray-400">
      该分类下暂无文章，敬请期待更新…
    </div>
  </section>

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.category-btn');
    const articleCards = document.querySelectorAll<HTMLElement>('.article-card');
    const noMatchAlert = document.getElementById('no-match-alert');
    const countIndicator = document.getElementById('count-indicator');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;

        filterButtons.forEach((b) => {
          b.classList.remove('active', 'border-gray-900', 'bg-gray-900', 'text-white');
          b.classList.add('border-gray-200', 'bg-white', 'text-gray-600');
        });
        btn.classList.remove('border-gray-200', 'bg-white', 'text-gray-600');
        btn.classList.add('active', 'border-gray-900', 'bg-gray-900', 'text-white');

        let visibleCount = 0;
        articleCards.forEach((card) => {
          if (filter === 'all' || card.dataset.category === filter) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countIndicator) {
          countIndicator.textContent = `显示 ${visibleCount} 篇`;
        }

        if (noMatchAlert) {
          noMatchAlert.classList.toggle('hidden', visibleCount > 0);
        }

        // 更新“查看专题独立页”链接
        const activeLink = document.getElementById('active-category-page-link') as HTMLAnchorElement | null;
        if (activeLink) {
          const base = activeLink.dataset.base ?? '/';
          if (filter && filter !== 'all') {
            activeLink.href = `${base}categories/${filter}/`;
            activeLink.classList.remove('hidden');
            activeLink.classList.add('inline-flex');
          } else {
            activeLink.classList.add('hidden');
            activeLink.classList.remove('inline-flex');
          }
        }
      });
    });

    // 随机漫游：随机抽取一篇文章跳转
    const randomBtn = document.getElementById('random-explore-btn');
    if (randomBtn) {
      randomBtn.addEventListener('click', () => {
        const articleLinks: string[] = [];
        articleCards.forEach((card) => {
          const link = card.querySelector('a')?.getAttribute('href');
          if (link) articleLinks.push(link);
        });

        if (articleLinks.length > 0) {
          const target = articleLinks[Math.floor(Math.random() * articleLinks.length)];
          window.location.href = target;
        }
      });
    }
  </script>
</Base>
