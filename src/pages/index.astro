---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import DailyCard from '../components/DailyCard.astro';
import { CATEGORIES, SITE_TITLE, SITE_DESCRIPTION, type CategoryKey } from '../consts';
import { DAILY_QUIZZES, getTodayIndex } from '../data/dailyQuiz';

const entries: CollectionEntry<'articles'>[] = await getCollection('articles');
const articles = entries
  .filter((entry) => !entry.id.startsWith('_'))
  .sort(
    (a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// 确定性计算今日主推词条与关联每日速测
const todayIdx = getTodayIndex(articles.length);
const featuredArticle = articles[todayIdx] ?? articles[0];
const todayQuiz = featuredArticle ? DAILY_QUIZZES[featuredArticle.id] : undefined;
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  {/* Slogan & Hero */}
  <section class="mb-8 text-center sm:text-left">
    <div class="inline-flex items-center gap-2 rounded-full bg-rose-50 border border-rose-100 px-3 py-1 text-xs font-medium text-rose-700 mb-3">
      <span>✨</span> 科学 · 自主 · 愉悦探索
    </div>
    <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
      每日性知识与愉悦探索科普
    </h1>
    <p class="mt-3 text-sm sm:text-base text-gray-600 leading-relaxed max-w-2xl">
      避开伪科学与营销套路。每日精选权威科普文章导读，涵盖避孕技巧、愉悦提升、生理机制与亲密沟通。
    </p>
  </section>

  {/* 今日精选科普与每日速测打卡 */}
  {featuredArticle && <DailyCard article={featuredArticle} quiz={todayQuiz} />}

  {/* 搜索与随机漫游 */}
  <section class="mb-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3" aria-label="站内检索与随机漫游">
    <div class="flex-1">
      <Search placeholder="搜索避孕、高潮、月经、愉悦技巧、知情同意…" />
    </div>
    <button
      type="button"
      id="random-explore-btn"
      class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-rose-200 bg-white px-3.5 py-2.5 text-xs font-semibold text-rose-700 shadow-2xs hover:bg-rose-50 hover:border-rose-300 transition-all cursor-pointer whitespace-nowrap"
      title="随机抽一篇科普文章阅读"
    >
      <span>🎲</span>
      <span class="hidden sm:inline">随便逛逛</span>
    </button>
    <a
      href={`${base}guide/decision-tree/`}
      class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-rose-500 to-rose-600 px-3.5 py-2.5 text-xs font-semibold text-white shadow-xs hover:from-rose-600 hover:to-rose-700 transition-all whitespace-nowrap"
      title="遇到避孕或突发出血意外？3步获取循证处置卡"
    >
      <span>⚡</span>
      <span>应急速查</span>
    </a>
  </section>

  {/* 分类快捷筛选 */}
  <section class="mb-8" aria-label="主题分类">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      <div class="flex flex-wrap items-center gap-2" id="category-filter-bar">
        <span class="text-gray-400 mr-1">分类：</span>
        <button
          type="button"
          data-filter="all"
          class="category-btn active rounded-full border border-gray-900 bg-gray-900 px-3.5 py-1 font-medium text-white transition-all cursor-pointer"
        >
          全部
        </button>
        {Object.entries(CATEGORIES).map(([key, item]) => (
          <button
            type="button"
            data-filter={key}
            class="category-btn rounded-full border border-gray-200 bg-white px-3.5 py-1 font-medium text-gray-600 hover:border-gray-300 transition-all cursor-pointer"
          >
            {item.label}
          </button>
        ))}
      </div>
      <a
        id="active-category-page-link"
        href="#"
        data-base={base}
        class="hidden text-xs text-rose-600 hover:text-rose-700 font-medium hover:underline items-center gap-1"
      >
        <span>查看专题独立页</span>
        <span>↗</span>
      </a>
    </div>
  </section>

  {/* 精选科普流 */}
  <section aria-label="精选文章列表">
    <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-6">
      <h2 class="text-lg font-bold text-gray-900" id="list-heading">最新精选</h2>
      <span class="text-xs text-gray-400" id="count-indicator">共收录 {articles.length} 篇</span>
    </div>

    {articles.length > 0 ? (
      <div class="space-y-4" id="article-list-container">
        {articles.map((article) => {
          const cat = CATEGORIES[article.data.category as CategoryKey] ?? {
            label: article.data.category,
            cls: 'bg-gray-100 text-gray-700 border-gray-200',
          };
          const dateStr = article.data.pubDate.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'numeric',
            day: 'numeric',
          });

          return (
            <article
              class="article-card group rounded-2xl border border-gray-100 bg-white p-5 shadow-xs transition-all hover:border-rose-200 hover:shadow-md"
              data-category={article.data.category}
            >
              <div class="flex flex-wrap items-center gap-2 mb-2 text-xs">
                <span class:list={['rounded-full border px-2.5 py-0.5 font-medium', cat.cls]}>
                  {cat.label}
                </span>
                <span class="rounded-full border border-gray-100 bg-gray-50 px-2 py-0.5 text-gray-500">
                  {article.data.is_full_text ? '📖 全文' : '💡 导读'}
                </span>
                <span class="text-gray-400 ml-auto">
                  {article.data.source_name} · <time datetime={article.data.pubDate.toISOString()}>{dateStr}</time>
                </span>
              </div>

              <h3 class="text-lg font-bold text-gray-900 group-hover:text-rose-600 transition-colors">
                <a href={`${base}articles/${article.id}/`} class="focus:outline-hidden">
                  {article.data.title}
                </a>
              </h3>

              <p class="mt-2 text-sm text-gray-600 line-clamp-2 leading-relaxed">
                {article.data.summary}
              </p>

              <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-gray-50 pt-3 text-xs">
                <div class="flex flex-wrap gap-1.5">
                  {article.data.tags.map((tag: string) => (
                    <span class="text-gray-400">#{tag}</span>
                  ))}
                </div>
                <a
                  href={`${base}articles/${article.id}/`}
                  class="font-medium text-rose-600 hover:text-rose-700 transition-colors"
                >
                  阅读导读与直达原文 →
                </a>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-gray-200 bg-white p-8 text-center text-sm text-gray-400">
        暂无文章，内容正在策展中…
      </div>
    )}

    <div id="no-match-alert" class="hidden rounded-2xl border border-dashed border-gray-200 bg-white p-8 text-center text-sm text-gray-400">
      该分类下暂无文章，敬请期待更新…
    </div>
  </section>

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.category-btn');
    const articleCards = document.querySelectorAll<HTMLElement>('.article-card');
    const noMatchAlert = document.getElementById('no-match-alert');
    const countIndicator = document.getElementById('count-indicator');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;

        filterButtons.forEach((b) => {
          b.classList.remove('active', 'border-gray-900', 'bg-gray-900', 'text-white');
          b.classList.add('border-gray-200', 'bg-white', 'text-gray-600');
        });
        btn.classList.remove('border-gray-200', 'bg-white', 'text-gray-600');
        btn.classList.add('active', 'border-gray-900', 'bg-gray-900', 'text-white');

        let visibleCount = 0;
        articleCards.forEach((card) => {
          if (filter === 'all' || card.dataset.category === filter) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countIndicator) {
          countIndicator.textContent = `显示 ${visibleCount} 篇`;
        }

        if (noMatchAlert) {
          noMatchAlert.classList.toggle('hidden', visibleCount > 0);
        }

        // 更新“查看专题独立页”链接
        const activeLink = document.getElementById('active-category-page-link') as HTMLAnchorElement | null;
        if (activeLink) {
          const base = activeLink.dataset.base ?? '/';
          if (filter && filter !== 'all') {
            activeLink.href = `${base}categories/${filter}/`;
            activeLink.classList.remove('hidden');
            activeLink.classList.add('inline-flex');
          } else {
            activeLink.classList.add('hidden');
            activeLink.classList.remove('inline-flex');
          }
        }
      });
    });

    // 🎲 随便逛逛：随机抽取一篇文章跳转
    const randomBtn = document.getElementById('random-explore-btn');
    if (randomBtn) {
      randomBtn.addEventListener('click', () => {
        const articleLinks: string[] = [];
        articleCards.forEach((card) => {
          const link = card.querySelector('a')?.getAttribute('href');
          if (link) articleLinks.push(link);
        });

        if (articleLinks.length > 0) {
          const target = articleLinks[Math.floor(Math.random() * articleLinks.length)];
          window.location.href = target;
        }
      });
    }
  </script>
</Base>
