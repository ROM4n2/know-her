---
/**
 * 词条详情页 /articles/[id]/
 * 适配 ADR-0002 轻量科普与策展导读体系
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import { CATEGORIES, type CategoryKey } from '../../consts';

interface Props {
  entry: CollectionEntry<'articles'>;
}

export async function getStaticPaths() {
  const entries: CollectionEntry<'articles'>[] = await getCollection('articles');
  return entries
    .filter((entry) => !entry.id.startsWith('_'))
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const url = new URL(pathname, Astro.site ?? 'https://rom4n2.github.io').href;

const categoryInfo = CATEGORIES[data.category as CategoryKey] ?? {
  label: data.category,
  cls: 'bg-gray-100 text-gray-700 border-gray-200',
};

const formattedDate = data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 计算字数与预计导读耗时
const charCount = (entry.body ?? '').replace(/\s+/g, '').length;
const readMinutes = Math.max(1, Math.ceil(charCount / 300));

const tierMap: Record<'A' | 'B' | 'C', { label: string; cls: string }> = {
  A: { label: 'Tier A 国际金标准', cls: 'bg-emerald-50 text-emerald-800 border-emerald-200' },
  B: { label: 'Tier B 临床专科共识', cls: 'bg-blue-50 text-blue-800 border-blue-200' },
  C: { label: 'Tier C 专业机构科普', cls: 'bg-purple-50 text-purple-800 border-purple-200' },
};
const tierInfo = tierMap[(data.evidence_tier as 'A' | 'B' | 'C') ?? 'B'];
const verifiedDateStr = data.last_verified_at
  ? data.last_verified_at.toISOString().split('T')[0]
  : formattedDate;

const allGlossary: CollectionEntry<'glossary'>[] = await getCollection('glossary');
const articleSlug = entry.id.replace(/\.(md|mdx)$/, '');
const relatedGlossary = allGlossary.filter(
  (g) => g.data.related_article === articleSlug || g.data.related_article === entry.id
);
---

<Base
  title={`${data.title} | know-her`}
  description={data.summary}
  type="article"
  pubDate={data.pubDate}
  author={data.author ?? data.source_name}
  tags={data.tags}
>
  <Fragment slot="head">
    <link rel="canonical" href={url} />
    <ArticleSchema
      title={data.title}
      url={url}
      summary={data.summary}
      pubDate={data.pubDate}
      category={categoryInfo.label}
      tags={data.tags}
      source_url={data.source_url}
      source_name={data.source_name}
      author={data.author}
      is_full_text={data.is_full_text}
    />
  </Fragment>

  <nav class="mb-6 flex items-center gap-2 text-xs text-gray-400">
    <a href={base} class="hover:text-rose-600 transition-colors">首页</a>
    <span>/</span>
    <a href={`${base}categories/${data.category}/`} class="hover:text-rose-600 transition-colors font-medium text-gray-600">
      {categoryInfo.label}
    </a>
    <span>/</span>
    <span class="text-gray-400 truncate max-w-[200px] sm:max-w-xs">{data.title}</span>
  </nav>

  <header class="mb-8">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <a
        href={`${base}categories/${data.category}/`}
        class:list={['rounded-full border px-2.5 py-0.5 text-xs font-medium hover:opacity-80 transition-opacity', categoryInfo.cls]}
      >
        {categoryInfo.label}
      </a>
      <a
        href={`${base}how-we-source/`}
        class:list={['rounded-full border px-2.5 py-0.5 text-xs font-medium hover:underline', tierInfo.cls]}
        title="点击查看 know-her 循证分级标准与信源准则"
      >
        {tierInfo.label}
      </a>
      <span class="rounded-full border border-stone-200 bg-white px-2.5 py-0.5 text-xs text-stone-600">
        {data.is_full_text ? '全文收录' : '精选导读'}
      </span>
      <span class="rounded-full border border-rose-100 bg-rose-50/60 px-2.5 py-0.5 text-xs text-rose-700">
        阅读约 {readMinutes} 分钟
      </span>
    </div>

    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 leading-snug">
      {data.title}
    </h1>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-500">
      <time datetime={data.pubDate.toISOString()}>{formattedDate}</time>
      <span>·</span>
      <span>来源：{data.source_name}</span>
      {data.author && (
        <>
          <span>·</span>
          <span>原作者：{data.author}</span>
        </>
      )}
      <span>·</span>
      <span title="经真机 HTTP 200 探针与人工质控核验">核验日期：{verifiedDateStr}</span>
      {data.reviewed_by && (
        <>
          <span>·</span>
          <span>复审：{data.reviewed_by}</span>
        </>
      )}
    </div>

    {/* 医学名词 In-situ 速查：鼠标悬浮或键盘聚焦即原地释义，无需跳转打断阅读心流 */}
    {relatedGlossary.length > 0 && (
      <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-2" aria-label="本文涉及的医学名词速查">
        <span class="glossary-inline-badge font-mono text-[11px] font-bold text-[#8B8676]">
          [ 名词速查 ]
        </span>
        {relatedGlossary.map((item) => (
          <span
            class="glossary-inline-term group relative inline-flex items-center gap-1 rounded-full border border-[#15140F]/15 bg-[#FAF8F5] px-2.5 py-1 text-[11px] font-semibold text-[#2A2620] cursor-help hover:border-rose-400 hover:text-rose-700 transition-colors"
            tabindex="0"
            title={item.data.definition}
          >
            <span>{item.data.term}</span>
            <span class="text-rose-600 font-mono">?</span>
            <span
              class="pointer-events-none absolute left-1/2 top-full z-30 hidden w-64 max-w-[calc(100vw-3rem)] -translate-x-1/2 translate-y-2 rounded-xl border border-[#15140F]/15 bg-white p-3 text-left text-[11px] font-normal leading-relaxed text-[#2A2620] shadow-[3px_3px_0_rgba(21,20,15,0.12)] group-hover:block group-focus-within:block"
            >
              <span class="mb-1 block font-bold text-[#15140F]">
                {item.data.term}
                {item.data.en_term ? ` · ${item.data.en_term}` : ''}
              </span>
              <span class="block">{item.data.definition}</span>
              <span class="mt-1.5 block text-[10px] text-[#8B8676]">出处：{item.data.source}</span>
            </span>
          </span>
        ))}
      </div>
    )}

    {/* 推荐理由 / 核心看点 Callout + 复制按钮 */}
    <div class="mt-6 rounded-xl border border-rose-100 bg-rose-50/50 p-4 text-sm text-gray-700 leading-relaxed">
      <div class="flex items-center justify-between gap-2 mb-2">
        <div class="flex items-center gap-1.5 font-semibold text-rose-800">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
          <span>核心导读与看点</span>
        </div>
        <button
          type="button"
          id="copy-summary-btn"
          class="inline-flex items-center gap-1.5 rounded-lg border border-[#15140F]/15 bg-white px-2.5 py-1 text-xs font-medium text-[#2A2620] hover:border-rose-300 hover:text-rose-700 transition-all cursor-pointer shadow-2xs"
          title="复制本篇核心看点卡片"
        >
          <svg class="w-3.5 h-3.5 text-[#8B8676]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75"/>
          </svg>
          <span id="copy-btn-text">复制要点</span>
        </button>
      </div>
      <p>{data.summary}</p>
    </div>

    {/* 非全文收录时的直达原文引导 */}
    {!data.is_full_text && (
      <div class="mt-4 flex items-center justify-between rounded-xl border border-gray-200 bg-white p-3.5 shadow-xs">
        <div class="text-xs text-gray-500">
          本文为精选策展导读，完整内容请访问原出处：
        </div>
        <a
          href={data.source_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-lg bg-gray-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-rose-600 transition-colors"
        >
          直达原文阅读 ↗
        </a>
      </div>
    )}
  </header>

  <article class="article-body">
    <Content />
  </article>

  {/* 关联的医学专业术语速查 */}
  {relatedGlossary.length > 0 && (
    <section class="mt-8 rounded-2xl border border-[#15140F]/12 bg-[#FAF8F5] p-5 space-y-3.5 shadow-2xs">
      <div class="flex items-center justify-between">
        <h3 class="text-xs sm:text-sm font-bold text-[#15140F] flex items-center gap-1.5">
          <span>本文涉及的医学专有名词速查</span>
        </h3>
        <a href={`${base}glossary/`} class="text-[11px] font-semibold text-rose-600 hover:text-rose-700 hover:underline">
          查阅完整词典 ↗
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {relatedGlossary.map((item) => (
          <a
            href={`${base}glossary/#term-${item.id}`}
            class="flex flex-col p-3 rounded-xl bg-white border border-[#15140F]/10 hover:border-rose-400 hover:shadow-xs transition-all text-left group shadow-2xs"
          >
            <div class="flex items-center justify-between gap-1 mb-1">
              <span class="font-bold text-xs text-[#15140F] group-hover:text-rose-700 transition-colors">
                {item.data.term}
              </span>
              {item.data.en_term && (
                <span class="text-[10px] font-mono text-[#8B8676] truncate max-w-[120px]">
                  {item.data.en_term}
                </span>
              )}
            </div>
            <p class="text-xs text-[#5A5448] line-clamp-2 leading-relaxed">
              {item.data.definition}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* 文章尾部：标签与直达链接 */}
  <footer class="mt-12 border-t border-[#15140F]/10 pt-6">
    {data.tags.length > 0 && (
      <div class="flex flex-wrap items-center gap-1.5 mb-6">
        <span class="text-xs text-[#8B8676] mr-1">标签：</span>
        {data.tags.map((tag: string) => (
          <span class="rounded-md bg-stone-100 border border-stone-200/80 px-2 py-0.5 text-xs text-[#5A5448]">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-xl border border-[#15140F]/15 bg-white p-4 shadow-2xs">
      <div class="text-xs text-[#5A5448] space-y-1">
        <p><strong>出处机构</strong>：{data.source_name}</p>
        <p class="break-all"><strong>原文链接</strong>：<a href={data.source_url} target="_blank" rel="noopener noreferrer" class="text-rose-600 hover:underline">{data.source_url}</a></p>
      </div>
      <a
        href={data.source_url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-[#15140F] px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-rose-600 active:translate-x-0.5 active:translate-y-0.5 transition-all shrink-0"
      >
        <span>前往 {data.source_name} 查阅原文</span>
        <span>↗</span>
      </a>
    </div>

    {/* 读者勘误通道 */}
    <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-[#15140F]/10 pt-3 text-xs text-[#5A5448]">
      <div class="flex items-center gap-1">
        <span>循证医学需要持续纠偏。若发现本篇数据有误或已过时：</span>
      </div>
      <a
        href={`https://github.com/ROM4n2/know-her/issues/new?title=${encodeURIComponent(`[勘误反馈] 《${data.title}》`)}&labels=correction&template=correction.yml`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-rose-600 font-semibold hover:underline inline-flex items-center gap-1"
      >
        <span>提交勘误反馈</span>
        <span>↗</span>
      </a>
    </div>
  </footer>

  {/* 顶部滚动阅读进度条 */}
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-[3px] bg-rose-600 z-50 transition-all duration-75 w-0"></div>

  <script is:inline define:vars={{ shareTitle: data.title, shareSummary: data.summary, shareSource: data.source_name, shareCategory: categoryInfo.label, shareUrl: url }}>
    // 监听滚动更新阅读进度条
    window.addEventListener('scroll', () => {
      const bar = document.getElementById('reading-progress-bar');
      if (!bar) return;
      const total = document.documentElement.scrollHeight - window.innerHeight;
      const progress = total > 0 ? (window.scrollY / total) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    }, { passive: true });

    document.getElementById('copy-summary-btn')?.addEventListener('click', async () => {
      const text = `【know-her 科普速览】《${shareTitle}》\n专题：${shareCategory} · 权威来源：${shareSource}\n\n核心看点：\n${shareSummary}\n\n完整导读与出处直达：\n${shareUrl}`;
      try {
        await navigator.clipboard.writeText(text);
        const btnText = document.getElementById('copy-btn-text');
        if (btnText) {
          btnText.textContent = '已复制！';
          setTimeout(() => {
            btnText.textContent = '复制要点';
          }, 2000);
        }
      } catch (err) {
        alert('复制失败，请手动选择文字进行复制。');
      }
    });
  </script>
</Base>

<style>
  .article-body :global(h2) {
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: #15140F;
    border-bottom: 1.5px solid rgba(21, 20, 15, 0.1);
    padding-bottom: 0.5rem;
  }
  .article-body :global(h3) {
    margin-top: 1.65rem;
    margin-bottom: 0.6rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: #15140F;
  }
  .article-body :global(p) {
    margin-top: 0.9rem;
    line-height: 1.85;
    color: #2A2620;
    font-size: 0.95rem;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
  }
  .article-body :global(ul) {
    list-style: disc;
  }
  .article-body :global(ol) {
    list-style: decimal;
  }
  .article-body :global(li) {
    margin-top: 0.35rem;
    line-height: 1.75;
    color: #2A2620;
    font-size: 0.95rem;
  }
  .article-body :global(strong) {
    font-weight: 700;
    color: #15140F;
  }
  .article-body :global(blockquote) {
    margin-top: 1rem;
    border-left: 3px solid #ED6F5C;
    background-color: #FAF8F5;
    padding: 0.75rem 1rem;
    border-radius: 0 0.5rem 0.5rem 0;
    color: #2A2620;
    font-size: 0.92rem;
  }
  .article-body :global(table) {
    width: 100%;
    margin-top: 1.25rem;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
    font-size: 0.85rem;
    border: 1px solid rgba(21, 20, 15, 0.12);
  }
  .article-body :global(th),
  .article-body :global(td) {
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(21, 20, 15, 0.12);
    text-align: left;
    vertical-align: top;
  }
  .article-body :global(th) {
    background-color: #F2ECE1;
    font-weight: 700;
    color: #15140F;
  }
  .article-body :global(tr:nth-child(even)) {
    background-color: rgba(242, 236, 225, 0.25);
  }
</style>
