---
/**
 * 词条详情页 /articles/[id]/
 *
 * - getStaticPaths：getCollection('articles') → 过滤 `_` 前缀私有模板（_template.mdx 不发布）
 * - 标题：frontmatter 无 title（schema .strict() 禁自造字段），取正文首个 H1，回退 headings / entry.id
 * - 装配：ArticleSchema（JSON-LD）、UnreviewedBanner（D4 医学未复审降级）、RedFlagCard（D5 急症红旗）
 *   MedicalDisclaimer 由 Base.astro 布局全局渲染
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Base from '../../layouts/Base.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import UnreviewedBanner from '../../components/UnreviewedBanner.astro';
import RedFlagCard from '../../components/RedFlagCard.astro';

// TODO(repo-owner): GitHub 仓库 owner 尚未确定，先用占位 `<owner>`；确定后替换为真实 owner。
const GITHUB_REPO_OWNER = '<owner>';
const CORRECTION_ISSUE_URL = `https://github.com/${GITHUB_REPO_OWNER}/know-her/issues/new?template=correction.yml`;

interface Props {
  entry: CollectionEntry<'articles'>;
}

export async function getStaticPaths() {
  const entries: CollectionEntry<'articles'>[] = await getCollection('articles');
  return entries
    .filter((entry) => !entry.id.startsWith('_'))
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;

/** 正文首个 H1 行（去 '# '）→ 页面标题；缺失时回退 headings h1 / entry.id */
const h1FromBody = entry.body?.match(/^#\s+(.+)$/m)?.[1]?.trim();
const h1FromHeadings = (headings as MarkdownHeading[]).find(
  (heading) => heading.depth === 1,
)?.text.trim();
const title = h1FromBody || h1FromHeadings || entry.id;

// canonical 与 RSS link 保持一致的尾斜杠形式
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const url = new URL(pathname, Astro.site ?? 'https://know-her.pages.dev').href;
// 外链+短摘要模式：摘要只回指来源与快照，不外推医学结论
const summary = `来源：${data.source_url}（快照日期 ${data.source_snapshot_date}）`;

const REVIEW_BADGES: Record<typeof data.review_status, { label: string; cls: string }> = {
  draft: { label: '草稿', cls: 'border-gray-300 bg-gray-100 text-gray-700' },
  in_review: { label: '审核中', cls: 'border-blue-300 bg-blue-100 text-blue-800' },
  published: { label: '已发布', cls: 'border-green-300 bg-green-100 text-green-800' },
  stale: { label: '待复审', cls: 'border-amber-300 bg-amber-100 text-amber-800' },
};
const badge = REVIEW_BADGES[data.review_status];
const sourceLinkClass =
  'text-blue-600 underline underline-offset-2 break-all hover:text-blue-800';
---

<Base title={`${title} | know-her`}>
  <Fragment slot="head">
    <link rel="canonical" href={url} />
    <meta name="description" content={summary} />
    <ArticleSchema title={title} url={url} summary={summary} {...data} />
  </Fragment>

  {/* D4：医学席位未复审时的降级横幅 */}
  {!data.reviewed_medical && <UnreviewedBanner medicalReviewed={false} />}

  {/* 元数据栏：来源链接 / 快照日期 / 审核状态徽章 */}
  <div
    class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-gray-200 py-3 text-sm text-gray-600"
    data-pagefind-ignore
  >
    <span class="min-w-0">
      来源：
      <a
        href={data.source_url}
        target="_blank"
        rel="noopener noreferrer"
        class={sourceLinkClass}>{data.source_url}</a
      >
    </span>
    <span>
      快照日期：
      <time datetime={data.source_snapshot_date}>{data.source_snapshot_date}</time>
    </span>
    <span
      class:list={[
        'rounded-full border px-2 py-0.5 text-xs font-medium',
        badge.cls,
      ]}>{badge.label}</span
    >
  </div>

  {/* D5：急症红旗清单（frontmatter red_flags，与正文急症红旗区块 1:1 双写） */}
  {data.red_flags.length > 0 && <RedFlagCard flags={data.red_flags} />}

  <article class="article-body mt-6">
    <Content />
  </article>

  {/* 底部：来源直达 + 免个人信息纠错引导 */}
  <footer
    class="mt-10 border-t border-gray-200 pt-6 text-sm text-gray-600"
    data-pagefind-ignore
  >
    <p>
      内容纠错：发现事实错误、失效链接或表述问题，请提交
      <a
        href={CORRECTION_ISSUE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class={sourceLinkClass}>纠错 Issue</a
      >
      （Issue 模板不收集任何个人信息，也不接受个人病史与医疗咨询）。
      {/* TODO(repo-owner): 占位 `<owner>` 待仓库 owner 确定后替换 */}
    </p>
    <p class="mt-2">
      来源直达：
      <a
        href={data.source_url}
        target="_blank"
        rel="noopener noreferrer"
        class={sourceLinkClass}>{data.source_url}</a
      >
      （快照 {data.source_snapshot_date}）
    </p>
  </footer>
</Base>

<style>
  /* 正文排版（Tailwind preflight 已重置默认样式；scoped + :global 只作用于本页正文容器） */
  .article-body :global(h1) {
    font-size: 1.875rem;
    line-height: 1.3;
    font-weight: 700;
    color: #111827;
  }
  .article-body :global(h2) {
    margin-top: 2rem;
    font-size: 1.375rem;
    font-weight: 700;
    color: #111827;
  }
  .article-body :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: #111827;
  }
  .article-body :global(p) {
    margin-top: 1rem;
    line-height: 1.75;
    color: #374151;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin-top: 1rem;
    padding-left: 1.5rem;
  }
  .article-body :global(ul) {
    list-style: disc;
  }
  .article-body :global(ol) {
    list-style: decimal;
  }
  .article-body :global(li) {
    margin-top: 0.375rem;
    line-height: 1.7;
    color: #374151;
  }
  .article-body :global(li) :global(p) {
    margin-top: 0;
  }
  .article-body :global(strong) {
    font-weight: 600;
    color: #111827;
  }
  .article-body :global(a) {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .article-body :global(blockquote) {
    margin-top: 1rem;
    border-left: 4px solid #d1d5db;
    padding-left: 1rem;
    color: #4b5563;
  }
  .article-body :global(table) {
    width: 100%;
    margin-top: 1rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid #e5e7eb;
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
    color: #374151;
  }
  .article-body :global(th) {
    background-color: #f9fafb;
    font-weight: 600;
    color: #111827;
  }
  .article-body :global(hr) {
    margin-top: 2rem;
    border-color: #e5e7eb;
  }
  .article-body :global(code) {
    font-size: 0.875em;
    background-color: #f3f4f6;
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
  }
  .article-body :global(pre) {
    margin-top: 1rem;
    overflow-x: auto;
    background-color: #f3f4f6;
    padding: 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .article-body :global(pre) :global(code) {
    background: none;
    padding: 0;
  }
</style>
