---
import '../styles/global.css';
import AgePreferenceBanner from '../components/AgePreferenceBanner.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';

interface Props {
  title?: string;
}

const { title = 'know-her' } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="know-her 妇科与性健康科普知识库"
      href="/rss.xml"
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-gray-900">
    <AgePreferenceBanner />
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8">
      <slot />
    </main>
    <MedicalDisclaimer />
  </body>
</html>
