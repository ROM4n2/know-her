---
import '../styles/global.css';
import { getCollection, type CollectionEntry } from 'astro:content';
import AgePreferenceBanner from '../components/AgePreferenceBanner.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
  tags?: string[];
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
  pubDate,
  author,
  tags = [],
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const siteUrl = Astro.site ?? new URL('https://rom4n2.github.io/know-her');
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(pathname, siteUrl).href;

const ogImage = image
  ? new URL(image, siteUrl).href
  : new URL(`${base}og-card.svg`, siteUrl).href;

// 供全局“随便逛逛”随机漫游使用
const allArticles: CollectionEntry<'articles'>[] = await getCollection('articles');
const validArticleUrls = allArticles
  .filter((a: CollectionEntry<'articles'>) => !a.id.startsWith('_'))
  .map((a: CollectionEntry<'articles'>) => `${base}articles/${a.id}/`);
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / WeChat / Social Meta -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="know-her" />
    <meta property="og:image" content={ogImage} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={`${base}rss.xml`}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-[#FAF8F5] text-[#2A2620] antialiased selection:bg-rose-100 selection:text-rose-900">
    <AgePreferenceBanner />

    {/* 桌面端与平板顶栏 */}
    <header class="border-b border-[#15140F]/10 bg-[#FAF8F5]/90 backdrop-blur-md sticky top-0 z-40">
      <div class="mx-auto flex w-full max-w-3xl items-center justify-between px-4 py-3 sm:py-3.5">
        <a href={base} class="flex items-center gap-2.5 group">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#15140F] text-white shadow-2xs group-hover:bg-rose-600 transition-colors">
            <svg class="w-4 h-4 text-rose-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3c-4.5 4.5-6 9-3 12 3 3 7.5 1.5 12-3-4.5-4.5-6-9-9-9Z"/>
              <path d="M12 3v18"/>
            </svg>
          </span>
          <div>
            <span class="font-extrabold text-[#15140F] tracking-tight text-base sm:text-lg group-hover:text-rose-600 transition-colors">know-her</span>
            <span class="ml-1.5 hidden sm:inline-block text-xs text-[#5A5448] font-normal">性健康科普与愉悦分享</span>
          </div>
        </a>
        <nav class="flex items-center gap-2.5 sm:gap-3.5 text-xs font-medium text-[#2A2620]">
          <a
            href={`${base}guide/decision-tree/`}
            class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 px-3 py-1 text-rose-700 font-semibold border border-rose-200/80 hover:bg-rose-100 transition-colors shadow-2xs"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-rose-600 shadow-[0_0_8px_rgba(225,29,72,0.8)] animate-pulse"></span>
            <span>应急速查</span>
          </a>
          <a href={`${base}tools/`} class="hover:text-rose-600 transition-colors px-1 py-1">工具箱</a>
          <a href={`${base}glossary/`} class="hover:text-rose-600 transition-colors px-1 py-1">词典</a>
          <a href={`${base}categories/contraception/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors px-1 py-1">避孕</a>
          <a href={`${base}categories/pleasure/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors px-1 py-1">愉悦</a>
          <a href={`${base}categories/body/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors px-1 py-1">身体</a>
          <a href={`${base}categories/intimacy/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors px-1 py-1">亲密</a>
          <a href={`${base}rss.xml`} class="hover:text-rose-600 transition-colors px-1 py-1" title="RSS 订阅">
            RSS
          </a>
        </nav>
      </div>
    </header>

    {/* 主内容区域：移动端保留吸底导航避让高度 */}
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8 pb-24 sm:pb-12">
      <slot />
    </main>

    <MedicalDisclaimer />

    {/* 移动端沉浸底栏 (Mobile Bottom Bar - 44px 触控黄金区，统一高质感矢量图标) */}
    <nav
      class="sm:hidden fixed bottom-0 left-0 right-0 z-50 bg-[#FAF8F5]/95 backdrop-blur-md border-t border-[#15140F]/10 px-2 py-1.5 flex items-center justify-around shadow-[0_-4px_16px_rgba(21,20,15,0.06)]"
      aria-label="移动端快捷导航"
    >
      <a
        href={base}
        class="flex flex-col items-center justify-center min-w-[48px] min-h-[44px] text-[#5A5448] hover:text-rose-600 transition-colors"
      >
        <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
        </svg>
        <span class="text-[10px] font-medium">首页</span>
      </a>
      <a
        href={`${base}guide/decision-tree/`}
        class="flex flex-col items-center justify-center min-w-[48px] min-h-[44px] text-rose-600 font-bold transition-colors"
      >
        <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z"/>
        </svg>
        <span class="text-[10px] font-bold">应急</span>
      </a>
      <a
        href={`${base}tools/`}
        class="flex flex-col items-center justify-center min-w-[48px] min-h-[44px] text-[#5A5448] hover:text-rose-600 transition-colors"
      >
        <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>
        </svg>
        <span class="text-[10px] font-medium">工具</span>
      </a>
      <a
        href={`${base}glossary/`}
        class="flex flex-col items-center justify-center min-w-[48px] min-h-[44px] text-[#5A5448] hover:text-rose-600 transition-colors"
      >
        <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
        </svg>
        <span class="text-[10px] font-medium">词典</span>
      </a>
      <button
        type="button"
        id="mobile-bottom-random-btn"
        class="flex flex-col items-center justify-center min-w-[48px] min-h-[44px] text-[#5A5448] hover:text-rose-600 transition-colors cursor-pointer"
        title="随机抽取一篇科普"
      >
        <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.678 48.678 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 0 0 3.7 3.7 48.656 48.656 0 0 0 7.324 0 4.006 4.006 0 0 0 3.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3-3 3"/>
        </svg>
        <span class="text-[10px] font-medium">漫游</span>
      </button>
    </nav>

    {/* 全局“随便逛逛”随机漫游脚本 */}
    <script is:inline define:vars={{ articleUrls: validArticleUrls }}>
      (function () {
        function triggerRandomArticle() {
          if (!articleUrls || articleUrls.length === 0) return;
          const target = articleUrls[Math.floor(Math.random() * articleUrls.length)];
          window.location.href = target;
        }

        document.getElementById('mobile-bottom-random-btn')?.addEventListener('click', triggerRandomArticle);
        document.getElementById('random-explore-btn')?.addEventListener('click', triggerRandomArticle);
      })();
    </script>
  </body>
</html>
