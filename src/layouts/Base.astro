---
import '../styles/global.css';
import { getCollection, type CollectionEntry } from 'astro:content';
import AgePreferenceBanner from '../components/AgePreferenceBanner.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
  tags?: string[];
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
  pubDate,
  author,
  tags = [],
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const siteUrl = Astro.site ?? new URL('https://rom4n2.github.io/know-her');
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(pathname, siteUrl).href;

const ogImage = image
  ? new URL(image, siteUrl).href
  : new URL(`${base}og-card.svg`, siteUrl).href;

// 供全局“随便逛逛”随机漫游使用
const allArticles: CollectionEntry<'articles'>[] = await getCollection('articles');
const validArticleUrls = allArticles
  .filter((a: CollectionEntry<'articles'>) => !a.id.startsWith('_'))
  .map((a: CollectionEntry<'articles'>) => `${base}articles/${a.id}/`);
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / WeChat / Social Meta -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="know-her" />
    <meta property="og:image" content={ogImage} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={`${base}rss.xml`}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-[#FAF8F5] text-[#2A2620] antialiased selection:bg-rose-100 selection:text-rose-900">
    <AgePreferenceBanner />

    {/* 桌面端与平板顶栏 */}
    <header class="border-b border-[#15140F]/10 bg-[#FAF8F5]/90 backdrop-blur-md sticky top-0 z-40">
      <div class="mx-auto flex w-full max-w-3xl items-center justify-between px-4 py-3 sm:py-3.5">
        <a href={base} class="flex items-center gap-2 group">
          <span class="text-xl sm:text-2xl transition-transform group-hover:scale-110">🌸</span>
          <div>
            <span class="font-extrabold text-gray-900 tracking-tight text-base sm:text-lg group-hover:text-rose-600 transition-colors">know-her</span>
            <span class="ml-1.5 hidden sm:inline-block text-xs text-[#5A5448] font-normal">性健康科普与愉悦分享</span>
          </div>
        </a>
        <nav class="flex items-center gap-2.5 sm:gap-3.5 text-xs font-medium text-[#2A2620]">
          <a
            href={`${base}guide/decision-tree/`}
            class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2.5 py-1 text-rose-700 font-semibold border border-rose-200/80 hover:bg-rose-100 transition-colors shadow-2xs"
          >
            <span>⚡</span>
            <span>应急速查</span>
          </a>
          <a href={`${base}glossary/`} class="hover:text-rose-600 transition-colors px-1 py-1">词典</a>
          <a href={`${base}categories/contraception/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors px-1 py-1">避孕</a>
          <a href={`${base}categories/pleasure/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors px-1 py-1">愉悦</a>
          <a href={`${base}categories/body/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors px-1 py-1">身体</a>
          <a href={`${base}categories/intimacy/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors px-1 py-1">亲密</a>
          <a href={`${base}rss.xml`} class="hover:text-rose-600 flex items-center gap-1 transition-colors px-1 py-1" title="RSS 订阅">
            <span>📡</span> <span class="hidden sm:inline">RSS</span>
          </a>
        </nav>
      </div>
    </header>

    {/* 主内容区域：移动端保留吸底导航避让高度 */}
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8 pb-24 sm:pb-12">
      <slot />
    </main>

    <MedicalDisclaimer />

    {/* 移动端沉浸底栏 (Mobile Bottom Bar - 44px 触控黄金区) */}
    <nav
      class="sm:hidden fixed bottom-0 left-0 right-0 z-50 bg-[#FAF8F5]/95 backdrop-blur-md border-t border-[#15140F]/10 px-3 py-1.5 flex items-center justify-around shadow-[0_-4px_16px_rgba(21,20,15,0.06)]"
      aria-label="移动端快捷导航"
    >
      <a
        href={base}
        class="flex flex-col items-center justify-center min-w-[48px] min-h-[44px] text-[#5A5448] hover:text-rose-600 transition-colors"
      >
        <span class="text-lg">🏠</span>
        <span class="text-[11px] font-medium mt-0.5">首页</span>
      </a>
      <a
        href={`${base}guide/decision-tree/`}
        class="flex flex-col items-center justify-center min-w-[48px] min-h-[44px] text-rose-600 font-bold transition-colors"
      >
        <span class="text-lg">⚡</span>
        <span class="text-[11px] font-bold mt-0.5">应急速查</span>
      </a>
      <a
        href={`${base}glossary/`}
        class="flex flex-col items-center justify-center min-w-[48px] min-h-[44px] text-[#5A5448] hover:text-rose-600 transition-colors"
      >
        <span class="text-lg">📖</span>
        <span class="text-[11px] font-medium mt-0.5">知识词典</span>
      </a>
      <button
        type="button"
        id="mobile-bottom-random-btn"
        class="flex flex-col items-center justify-center min-w-[48px] min-h-[44px] text-[#5A5448] hover:text-rose-600 transition-colors cursor-pointer"
        title="随机抽取一篇科普"
      >
        <span class="text-lg">🎲</span>
        <span class="text-[11px] font-medium mt-0.5">随便逛逛</span>
      </button>
    </nav>

    {/* 全局“随便逛逛”随机漫游脚本 */}
    <script is:inline define:vars={{ articleUrls: validArticleUrls }}>
      (function () {
        function triggerRandomArticle() {
          if (!articleUrls || articleUrls.length === 0) return;
          const target = articleUrls[Math.floor(Math.random() * articleUrls.length)];
          window.location.href = target;
        }

        document.getElementById('mobile-bottom-random-btn')?.addEventListener('click', triggerRandomArticle);
        document.getElementById('random-explore-btn')?.addEventListener('click', triggerRandomArticle);
      })();
    </script>
  </body>
</html>
