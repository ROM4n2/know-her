---
import '../styles/global.css';
import AgePreferenceBanner from '../components/AgePreferenceBanner.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
  tags?: string[];
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
  pubDate,
  author,
  tags = [],
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const siteUrl = Astro.site ?? new URL('https://rom4n2.github.io/know-her');
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(pathname, siteUrl).href;

const ogImage = image
  ? new URL(image, siteUrl).href
  : new URL(`${base}og-card.svg`, siteUrl).href;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / WeChat / Social Meta -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="know-her" />
    <meta property="og:image" content={ogImage} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={`${base}rss.xml`}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-[#fafaf9] text-gray-800 antialiased selection:bg-rose-100 selection:text-rose-900">
    <AgePreferenceBanner />
    <header class="border-b border-gray-100 bg-white/80 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto flex w-full max-w-3xl items-center justify-between px-4 py-3.5">
        <a href={base} class="flex items-center gap-2 group">
          <span class="text-xl">🌸</span>
          <div>
            <span class="font-bold text-gray-900 tracking-tight group-hover:text-rose-600 transition-colors">know-her</span>
            <span class="ml-1.5 hidden sm:inline-block text-xs text-gray-400 font-normal">性健康科普与愉悦分享</span>
          </div>
        </a>
        <nav class="flex items-center gap-3.5 text-xs font-medium text-gray-600">
          <a
            href={`${base}guide/decision-tree/`}
            class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2.5 py-1 text-rose-700 font-semibold border border-rose-100 hover:bg-rose-100 transition-colors"
          >
            <span>⚡</span>
            <span>应急速查</span>
          </a>
          <a href={`${base}categories/contraception/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors">避孕</a>
          <a href={`${base}categories/pleasure/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors">愉悦</a>
          <a href={`${base}categories/body/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors">身体</a>
          <a href={`${base}categories/intimacy/`} class="hidden sm:inline-block hover:text-rose-600 transition-colors">亲密</a>
          <a href={`${base}rss.xml`} class="hover:text-rose-600 flex items-center gap-1 transition-colors" title="RSS 订阅">
            <span>📡</span> RSS
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8">
      <slot />
    </main>

    <MedicalDisclaimer />
  </body>
</html>
